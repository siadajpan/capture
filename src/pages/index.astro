            }
            const btn1 = document.getElementById(`live-btn-${deviceId}-${target}`);
            if (btn1) btn1.textContent = `⏹ ${rem}s`;
            const btn2 = document.getElementById(`live-btn-foot-${deviceId}-${target}`);
            if (btn2) btn2.textContent = `⏹ ${rem}s`;
          }
        }, 1000);
      };


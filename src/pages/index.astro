---
import '../styles/global.css';

const title = "CAPTURE.ME.UK v1.4 | Multi-Sensor Edge Collector";
const description = "Cloudflare-hosted mobile dashboard to monitor live streams and synchronize recording across multi-sensor edge devices.";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" content="#00e5ff">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="manifest" href="/manifest.webmanifest">
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
</head>
<body>
  <div class="app-container">
    <!-- Slim Modern Top Bar -->
    <header class="top-nav-slim">
      <div class="nav-left">
        <div class="brand-badge">
          <div class="pulse-dot"></div>
          <span class="brand-title">CAPTURE <small style="font-size:0.65rem;color:var(--accent-cyan);vertical-align:middle;font-weight:600;opacity:0.85;margin-left:2px;">v1.4</small></span>
        </div>

        <div class="nav-segmented">
          <button id="viewByModalityBtn" class="nav-seg-btn active" type="button" title="Group by Sensors">Sensors</button>
          <button id="viewByDeviceBtn" class="nav-seg-btn" type="button" title="Group by Device">Devices</button>
          <button id="viewPlaybackBtn" class="nav-seg-btn" type="button" title="View Recorded Frames & Scrubber">🎞️ Playback</button>
        </div>

        <div class="filter-pills" id="modalityPillsBar">
          <button class="pill active" data-mod="all" type="button">All</button>
          <button class="pill" data-mod="rgb" type="button">RGB</button>
          <button class="pill" data-mod="thermal" type="button">Thermal</button>
          <button class="pill" data-mod="depth" type="button">Depth</button>
        </div>
      </div>

      <div class="nav-right">
        <!-- Live Video Toggle Pill -->
        <button id="quickDisplayBtn" class="nav-pill-btn active" type="button" title="Toggle Live Feeds">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
          <span id="quickDisplayLabel">LIVE</span>
        </button>

        <!-- Recording Pill -->
        <button id="quickRecordBtn" class="nav-pill-btn record-pill" type="button" title="Toggle Synchronized Edge Recording">
          <div class="record-dot"></div>
          <span id="quickRecordLabel">REC</span>
        </button>

        <!-- System & Tunnel Menu Button -->
        <button id="openMenuBtn" class="menu-btn" type="button" title="Open Settings & System Menu">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
          <span class="menu-btn-label">Menu</span>
          <span class="menu-badge" id="menuEdgeBadge">0</span>
        </button>
      </div>
    </header>

    <!-- Main Dynamic Feed Container (Centered 3/2 Columns) -->
    <main class="feeds-viewport" id="feedsViewport">
      <div class="loading-state">
        <div class="spinner"></div>
        <p>Connecting to Edge Devices via capture.me.uk...</p>
      </div>
    </main>

    <!-- Playback & Historical Frame Scrubbing Studio -->
    <section class="playback-viewport" id="playbackViewport" style="display: none;">
      <div class="playback-header-bar">
        <div class="playback-header-left">
          <span style="font-size:0.82rem; font-weight:700; color:var(--text-main); display:inline-flex; align-items:center; gap:6px;">
            <span>🎞️</span>
            <span>Session:</span>
          </span>
          <select id="playbackSessionSelect" class="playback-select" title="Select recorded session">
            <option value="">Loading sessions...</option>
          </select>
          <button id="refreshSessionsBtn" class="nav-seg-btn" type="button" style="padding: 4px 10px; font-size: 0.74rem;" title="Refresh Sessions">🔄 Refresh</button>
        </div>

        <div class="playback-header-right">
          <span class="playback-badge-chip" id="playbackSessionMetaBadge">-- frames &bull; --s</span>
          <select id="playbackDeviceFilter" class="playback-select" title="Filter device / modality view">
            <option value="all">Synchronized Fleet Grid (All Devices)</option>
          </select>
        </div>
      </div>

      <!-- Playback Grid of Cards -->
      <div class="playback-grid" id="playbackGrid">
        <div class="empty-state" style="grid-column: 1 / -1; padding: 36px 16px;">
          <p>Select a session to scrub and preview recorded frames.</p>
        </div>
      </div>

      <!-- Bottom Interactive Timeline Scrubber Dock -->
      <div class="playback-scrubber-dock" id="playbackScrubberDock">
        <div class="playback-slider-row">
          <div class="playback-slider-wrapper">
            <div class="playback-buffer-bar" id="playbackBufferBar" style="width: 0%;"></div>
            <input type="range" id="playbackSlider" class="timeline-slider" min="1" max="1" value="1" title="Drag to scrub through recorded frames">
          </div>
        </div>

        <div class="playback-controls-row">
          <div class="transport-btn-group">
            <button type="button" class="transport-btn" id="btnPlayFirst" title="First Frame (Home)">⏮</button>
            <button type="button" class="transport-btn" id="btnPlayPrev" title="Previous Frame (Left Arrow)">◀</button>
            <button type="button" class="transport-btn play-btn" id="btnPlayToggle" title="Play / Pause (Spacebar)">▶</button>
            <button type="button" class="transport-btn" id="btnPlayNext" title="Next Frame (Right Arrow)">▶</button>
            <button type="button" class="transport-btn" id="btnPlayLast" title="Last Frame (End)">⏭</button>
          </div>

          <div class="playback-hud-text">
            <span>FRAME <strong class="playback-hud-frame" id="playbackHudFrame">1 / 1</strong></span>
            <span style="color:var(--text-dim);">|</span>
            <span id="playbackHudTime">+00:00.0s / 00:00.0s</span>
          </div>

          <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
            <span class="buffer-chip" id="playbackBufferBadge" title="Frames cached in browser memory for instant smooth playback">RAM: 0%</span>
            <button type="button" class="btn-secondary-action" id="btnSyncHub" title="Download all session frames to PC Hub disk for offline access">💾 Cache to PC</button>
            <span style="font-size:0.75rem; color:var(--text-muted); margin-left:4px;">Speed:</span>
            <select id="playbackSpeedSelect" class="playback-speed-select">
              <option value="0.5">0.5x</option>
              <option value="1" selected>1.0x (10fps)</option>
              <option value="2">2.0x (20fps)</option>
            </select>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Fleet Management & Hub Settings Modal -->
  <div class="modal-backdrop" id="modalBackdrop">
    <div class="modal-card wide-modal">
      <div class="modal-header">
        <div class="modal-header-tabs">
          <button type="button" class="modal-tab-btn active" id="tabOverviewBtn" data-tab="overview">
            <span>🌐</span>
            <span>Overview & Tunnel</span>
          </button>
          <button type="button" class="modal-tab-btn" id="tabFleetBtn" data-tab="fleet">
            <span>💻</span>
            <span>Fleet (<span id="modalFleetBadge">0/0</span>)</span>
          </button>
          <button type="button" class="modal-tab-btn" id="tabAddBtn" data-tab="add">
            <span>➕</span>
            <span>Add Device</span>
          </button>
          <button type="button" class="modal-tab-btn" id="tabConfigBtn" data-tab="config">
            <span>⚙️</span>
            <span>Hub Settings</span>
          </button>
        </div>
        <button class="close-btn" id="closeModalBtn" title="Close modal">&times;</button>
      </div>

      <div class="modal-body">
        <!-- TAB 1: OVERVIEW & TUNNEL -->
        <div class="modal-tab-pane active" id="tabPaneOverview">
          <!-- Cloudflare Tunnel Info Box -->
          <div class="tunnel-highlight-card">
            <div class="tunnel-card-header">
              <div class="tunnel-status-pill">
                <span class="pulse-dot-green"></span>
                <span>CLOUDFLARE TUNNEL</span>
              </div>
              <span class="tunnel-badge-active">ONLINE</span>
            </div>
            
            <div class="tunnel-url-row">
              <div class="tunnel-url-display" id="modalTunnelUrl">https://marvel-reconstruction-atm-planning.trycloudflare.com</div>
              <button type="button" class="copy-btn-tunnel" id="copyTunnelBtn" title="Copy Tunnel URL">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                <span id="copyBtnText">Copy</span>
              </button>
              <a href="https://marvel-reconstruction-atm-planning.trycloudflare.com" target="_blank" rel="noopener" class="open-link-btn" id="openTunnelLink" title="Open in new window">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
              </a>
            </div>

            <div class="tunnel-meta-row">
              <span><strong>Local LAN Hub:</strong> <code id="localIpLabel">http://192.168.137.1:8000</code></span>
              <span><strong>Custom Domain:</strong> <code>capture.me.uk</code></span>
            </div>
          </div>

          <!-- System Stats Grid -->
          <div class="menu-stats-grid">
            <div class="menu-stat-card">
              <span class="stat-num text-accent" id="menuSensorsCount">0</span>
              <span class="stat-sub">Active Sensors</span>
            </div>
            <div class="menu-stat-card">
              <span class="stat-num text-green" id="menuOnlineEdges">0/0</span>
              <span class="stat-sub">Edges Online</span>
            </div>
            <div class="menu-stat-card">
              <span class="stat-num" id="menuFreeStorage">--</span>
              <span class="stat-sub">SD Card Free</span>
            </div>
            <div class="menu-stat-card">
              <span class="stat-num" id="menuRecDuration">00:00:00</span>
              <span class="stat-sub" id="menuRecStatusLabel">Standby</span>
            </div>
          </div>

          <!-- Synchronized Recording Controls -->
          <div class="menu-rec-section">
            <div class="rec-section-header">
              <h4>🔴 Edge Synchronized Recording</h4>
              <span class="badge-tag" id="menuRecBadge">IDLE</span>
            </div>
            <p class="rec-section-desc">Starts synchronized local MJPEG / raw frame recording simultaneously across all connected edge nodes to internal SD card storage.</p>
            <div class="rec-controls-bar">
              <input type="text" id="recSessionLabelInput" placeholder="Session label" value="capture.me.uk Session" class="rec-label-input">
              <button type="button" id="modalCollectBtn" class="modal-action-btn record-action-btn">
                <div class="record-symbol"></div>
                <span id="modalCollectBtnText">Start Recording</span>
              </button>
            </div>
            <div class="storage-path-box">
              <span class="path-title">Internal Edge File Pattern:</span>
              <code>&lt;device&gt;/&lt;YYYY-MM-DD&gt;/&lt;HH-MM-SS&gt;/&lt;modality&gt;/frame_*.jpg</code>
            </div>
          </div>
        </div>

        <!-- TAB 2: FLEET AVAILABILITY -->
        <div class="modal-tab-pane" id="tabPaneFleet">
          <div class="fleet-header-summary">
            <div class="fleet-stats">
              <span class="stat-pill"><strong id="summaryTotalEdges">0</strong> Total Devices</span>
              <span class="stat-pill online-pill"><strong id="summaryOnlineEdges">0</strong> Available Online</span>
            </div>
            <button type="button" class="pill-btn-refresh" id="refreshFleetBtn" title="Ping & Test all devices">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
              </svg>
              <span>Ping / Refresh</span>
            </button>
          </div>

          <div class="fleet-cards-list" id="fleetCardsContainer">
            <!-- Dynamically populated -->
          </div>
        </div>

        <!-- TAB 2: ADD NEW DEVICE -->
        <div class="modal-tab-pane" id="tabPaneAdd">
          <div class="phone-connect-box">
            <h4>➕ Register New Edge Device</h4>
            <p>Connect another Raspberry Pi Zero, 4/5, or Linux camera rig to the centralized aggregator:</p>
          </div>
          <form id="addEdgeForm" class="add-edge-form">
            <div class="form-row">
              <div class="form-group flex-2">
                <label>Device Name / Label</label>
                <input type="text" id="edgeNameInput" placeholder="Raspberry Pi Zero (STEVAL-55G0MBI)" required>
              </div>
              <div class="form-group flex-1">
                <label>Device ID</label>
                <input type="text" id="edgeIdInput" placeholder="edge-pi-zero-02" required>
              </div>
            </div>
            <div class="form-row">
              <div class="form-group flex-2">
                <label>IP Address / Hostname / Tailscale</label>
                <input type="text" id="edgeHostInput" placeholder="192.168.137.240" required>
              </div>
              <div class="form-group flex-1">
                <label>Port</label>
                <input type="number" id="edgePortInput" value="5001" required>
              </div>
            </div>
            <button type="submit" class="submit-btn">+ Add Edge Device</button>
          </form>
        </div>

        <!-- TAB 3: HUB & TUNNEL CONFIG -->
        <div class="modal-tab-pane" id="tabPaneConfig">
          <div class="phone-connect-box">
            <h4>🌐 Edge Hub & Cloudflare Tunnel Endpoint</h4>
            <p>Specify the proxy hub or Cloudflare Tunnel that bridges browser visitors to your edge fleet:</p>
            <div style="display:flex; gap:8px; margin-bottom:8px;">
              <input type="text" id="hubUrlInput" style="flex:1; background:rgba(0,0,0,0.4); border:1px solid var(--border-color); color:#fff; padding:8px; border-radius:6px; font-family:var(--font-mono); font-size:0.85rem;" placeholder="https://marvel-reconstruction-atm-planning.trycloudflare.com">
              <button type="button" class="copy-btn" id="saveHubUrlBtn">Save</button>
            </div>
            <div style="display:flex; gap:6px; flex-wrap:wrap; margin-bottom:10px;">
              <button type="button" class="pill active" id="btnPresetDefault" style="font-size:0.75rem; padding:4px 8px; cursor:pointer;">☁️ Reset to Server Default (config.json)</button>
              <button type="button" class="pill" id="btnPresetLocal" style="font-size:0.75rem; padding:4px 8px; cursor:pointer;" onclick="window.setQuickHub('http://127.0.0.1:8000')">💻 Local PC Hub (8000)</button>
              <button type="button" class="pill" id="btnPresetDirectPi" style="font-size:0.75rem; padding:4px 8px; cursor:pointer;" onclick="window.setQuickHub('http://192.168.137.240:5001')">🍓 Direct Pi (5001)</button>
            </div>
            <small style="color:var(--text-muted); font-size:0.75rem;">Visitors to <code>capture.me.uk</code> automatically load the default endpoint from <code>/config.json</code>.</small>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Client-Side Dashboard Script -->
  <script is:inline>
    (function () {
      'use strict';

      let clientConfig = null;
      let hubBaseUrl = '';

      async function loadClientConfig() {
        try {
          const res = await fetch('/config.json?v=' + Date.now());
          if (res.ok) {
            clientConfig = await res.json();
          }
        } catch (e) {
          console.warn('Could not load /config.json:', e);
        }

        const defaultHub = clientConfig?.default_hub_url || (
          (window.location.port === '8000') 
            ? window.location.origin 
            : (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1')
              ? 'http://127.0.0.1:8000'
              : 'https://marvel-reconstruction-atm-planning.trycloudflare.com'
        );

        let savedHub = localStorage.getItem('capture_hub_url');
        if (savedHub && (savedHub.includes('192.168.41.78') || savedHub.includes('192.168.1.100') || savedHub.includes('192.168.1.150') || savedHub.includes('lynn-oak'))) {
          savedHub = null;
          localStorage.removeItem('capture_hub_url');
        }

        hubBaseUrl = savedHub || defaultHub;
      }

      const state = {
        viewMode: 'modality',
        selectedModalityFilter: 'all',
        displayEnabled: true,
        isRecording: false,
        edges: [],
        pollTimer: null,

        // Playback & Frame Scrubbing State
        playbackSessions: [],
        currentSession: null,
        currentFrameIdx: 1,
        maxFrames: 1,
        isPlaying: false,
        playbackTimer: null,
        playbackSpeed: 1.0,
        selectedPlaybackFilter: 'all'
      };

      const el = {
        openMenuBtn: document.getElementById('openMenuBtn'),
        quickDisplayBtn: document.getElementById('quickDisplayBtn'),
        quickDisplayLabel: document.getElementById('quickDisplayLabel'),
        quickRecordBtn: document.getElementById('quickRecordBtn'),
        quickRecordLabel: document.getElementById('quickRecordLabel'),
        menuEdgeBadge: document.getElementById('menuEdgeBadge'),

        viewByDeviceBtn: document.getElementById('viewByDeviceBtn'),
        viewByModalityBtn: document.getElementById('viewByModalityBtn'),
        viewPlaybackBtn: document.getElementById('viewPlaybackBtn'),
        modalityPillsBar: document.getElementById('modalityPillsBar'),
        feedsViewport: document.getElementById('feedsViewport'),

        // Playback UI Elements
        playbackViewport: document.getElementById('playbackViewport'),
        playbackSessionSelect: document.getElementById('playbackSessionSelect'),
        refreshSessionsBtn: document.getElementById('refreshSessionsBtn'),
        playbackSessionMetaBadge: document.getElementById('playbackSessionMetaBadge'),
        playbackDeviceFilter: document.getElementById('playbackDeviceFilter'),
        playbackGrid: document.getElementById('playbackGrid'),
        playbackSlider: document.getElementById('playbackSlider'),
        btnPlayFirst: document.getElementById('btnPlayFirst'),
        btnPlayPrev: document.getElementById('btnPlayPrev'),
        btnPlayToggle: document.getElementById('btnPlayToggle'),
        btnPlayNext: document.getElementById('btnPlayNext'),
        btnPlayLast: document.getElementById('btnPlayLast'),
        playbackHudFrame: document.getElementById('playbackHudFrame'),
        playbackHudTime: document.getElementById('playbackHudTime'),
        playbackSpeedSelect: document.getElementById('playbackSpeedSelect'),
        playbackBufferBar: document.getElementById('playbackBufferBar'),
        playbackBufferBadge: document.getElementById('playbackBufferBadge'),
        btnSyncHub: document.getElementById('btnSyncHub'),

        modalBackdrop: document.getElementById('modalBackdrop'),
        closeModalBtn: document.getElementById('closeModalBtn'),
        tabOverviewBtn: document.getElementById('tabOverviewBtn'),
        tabFleetBtn: document.getElementById('tabFleetBtn'),
        tabAddBtn: document.getElementById('tabAddBtn'),
        tabConfigBtn: document.getElementById('tabConfigBtn'),

        modalTunnelUrl: document.getElementById('modalTunnelUrl'),
        copyTunnelBtn: document.getElementById('copyTunnelBtn'),
        copyBtnText: document.getElementById('copyBtnText'),
        openTunnelLink: document.getElementById('openTunnelLink'),
        localIpLabel: document.getElementById('localIpLabel'),

        menuSensorsCount: document.getElementById('menuSensorsCount'),
        menuOnlineEdges: document.getElementById('menuOnlineEdges'),
        menuFreeStorage: document.getElementById('menuFreeStorage'),
        menuRecDuration: document.getElementById('menuRecDuration'),
        menuRecStatusLabel: document.getElementById('menuRecStatusLabel'),
        menuRecBadge: document.getElementById('menuRecBadge'),

        recSessionLabelInput: document.getElementById('recSessionLabelInput'),
        modalCollectBtn: document.getElementById('modalCollectBtn'),
        modalCollectBtnText: document.getElementById('modalCollectBtnText'),

        hubUrlInput: document.getElementById('hubUrlInput'),
        saveHubUrlBtn: document.getElementById('saveHubUrlBtn'),
        btnPresetDefault: document.getElementById('btnPresetDefault'),

        addEdgeForm: document.getElementById('addEdgeForm'),
        edgeNameInput: document.getElementById('edgeNameInput'),
        edgeIdInput: document.getElementById('edgeIdInput'),
        edgeHostInput: document.getElementById('edgeHostInput'),
        edgePortInput: document.getElementById('edgePortInput'),
        fleetCardsContainer: document.getElementById('fleetCardsContainer'),
        modalFleetBadge: document.getElementById('modalFleetBadge'),
        summaryTotalEdges: document.getElementById('summaryTotalEdges'),
        summaryOnlineEdges: document.getElementById('summaryOnlineEdges'),
        refreshFleetBtn: document.getElementById('refreshFleetBtn')
      };

      async function init() {
        await loadClientConfig();
        if (el.hubUrlInput) el.hubUrlInput.value = hubBaseUrl;
        bindEvents();
        await fetchSystemInfo();
        await pollData();
        state.pollTimer = setInterval(pollData, 1800);
      }

      async function fetchSystemInfo() {
        try {
          const res = await fetch(`${hubBaseUrl}/api/info`);
          if (res.ok) {
            const info = await res.json();
            const tunnel = info.tunnel_url || clientConfig?.default_hub_url || hubBaseUrl;
            if (el.modalTunnelUrl) el.modalTunnelUrl.textContent = tunnel;
            if (el.openTunnelLink) el.openTunnelLink.href = tunnel;
            if (el.localIpLabel && info.mobile_url) el.localIpLabel.textContent = info.mobile_url;
          }
        } catch (e) {
          const fallbackTunnel = clientConfig?.default_hub_url || 'https://marvel-reconstruction-atm-planning.trycloudflare.com';
          if (el.modalTunnelUrl) el.modalTunnelUrl.textContent = fallbackTunnel;
          if (el.openTunnelLink) el.openTunnelLink.href = fallbackTunnel;
        }
      }

      window.switchModalTab = function (tabName) {
        document.querySelectorAll('.modal-tab-btn').forEach(btn => {
          btn.classList.toggle('active', btn.dataset.tab === tabName);
        });
        document.querySelectorAll('.modal-tab-pane').forEach(pane => {
          pane.classList.remove('active');
        });
        const target = document.getElementById('tabPane' + tabName.charAt(0).toUpperCase() + tabName.slice(1));
        if (target) target.classList.add('active');
      };

      function bindEvents() {
        if (el.quickDisplayBtn) el.quickDisplayBtn.addEventListener('click', toggleDisplay);
        if (el.quickRecordBtn) el.quickRecordBtn.addEventListener('click', toggleCollection);
        if (el.modalCollectBtn) el.modalCollectBtn.addEventListener('click', toggleCollection);

        if (el.viewByDeviceBtn) el.viewByDeviceBtn.addEventListener('click', () => switchViewMode('device'));
        if (el.viewByModalityBtn) el.viewByModalityBtn.addEventListener('click', () => switchViewMode('modality'));
        if (el.viewPlaybackBtn) el.viewPlaybackBtn.addEventListener('click', () => switchViewMode('playback'));

        if (el.modalityPillsBar) {
          el.modalityPillsBar.addEventListener('click', (e) => {
            const btn = e.target.closest('.pill');
            if (!btn) return;
            document.querySelectorAll('#modalityPillsBar .pill').forEach(p => p.classList.remove('active'));
            btn.classList.add('active');
            state.selectedModalityFilter = btn.dataset.mod;
            renderFeeds();
          });
        }

        if (el.openMenuBtn) {
          el.openMenuBtn.addEventListener('click', () => {
            window.switchModalTab('overview');
            el.modalBackdrop.classList.add('open');
          });
        }

        if (el.copyTunnelBtn) {
          el.copyTunnelBtn.addEventListener('click', () => {
            const url = el.modalTunnelUrl ? el.modalTunnelUrl.textContent.trim() : hubBaseUrl;
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(url).then(() => {
                if (el.copyBtnText) el.copyBtnText.textContent = 'Copied!';
                setTimeout(() => { if (el.copyBtnText) el.copyBtnText.textContent = 'Copy'; }, 2000);
              }).catch(() => fallbackCopy(url));
            } else {
              fallbackCopy(url);
            }
          });
        }

        function fallbackCopy(text) {
          const ta = document.createElement('textarea');
          ta.value = text;
          document.body.appendChild(ta);
          ta.select();
          try {
            document.execCommand('copy');
            if (el.copyBtnText) el.copyBtnText.textContent = 'Copied!';
            setTimeout(() => { if (el.copyBtnText) el.copyBtnText.textContent = 'Copy'; }, 2000);
          } catch (e) {}
          document.body.removeChild(ta);
        }

        if (el.closeModalBtn) {
          el.closeModalBtn.addEventListener('click', () => el.modalBackdrop.classList.remove('open'));
        }

        if (el.modalBackdrop) {
          el.modalBackdrop.addEventListener('click', (e) => {
            if (e.target === el.modalBackdrop) el.modalBackdrop.classList.remove('open');
          });
        }

        // Modal Tab Buttons
        [el.tabOverviewBtn, el.tabFleetBtn, el.tabAddBtn, el.tabConfigBtn].forEach(tabBtn => {
          if (tabBtn) {
            tabBtn.addEventListener('click', () => window.switchModalTab(tabBtn.dataset.tab));
          }
        });

        if (el.refreshFleetBtn) {
          el.refreshFleetBtn.addEventListener('click', async () => {
            el.refreshFleetBtn.textContent = 'Pinging...';
            await pollData();
            setTimeout(() => {
              el.refreshFleetBtn.innerHTML = `
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
                </svg>
                <span>Ping / Refresh</span>
              `;
            }, 600);
          });
        }

        if (el.btnPresetDefault) {
          el.btnPresetDefault.addEventListener('click', async () => {
            await loadClientConfig();
            const target = clientConfig?.default_hub_url || 'https://marvel-reconstruction-atm-planning.trycloudflare.com';
            window.setQuickHub(target);
          });
        }

        if (el.saveHubUrlBtn) {
          el.saveHubUrlBtn.addEventListener('click', () => {
            let val = el.hubUrlInput.value.trim();
            if (val && !val.startsWith('http')) val = 'http://' + val;
            hubBaseUrl = val;
            localStorage.setItem('capture_hub_url', hubBaseUrl);
            pollData();
            fetchSystemInfo();
            el.saveHubUrlBtn.textContent = 'Saved!';
            setTimeout(() => el.saveHubUrlBtn.textContent = 'Save', 2000);
          });
        }

        window.setQuickHub = function (url) {
          hubBaseUrl = url;
          localStorage.setItem('capture_hub_url', hubBaseUrl);
          if (el.hubUrlInput) el.hubUrlInput.value = hubBaseUrl;
          pollData();
          fetchSystemInfo();
          if (el.saveHubUrlBtn) {
            el.saveHubUrlBtn.textContent = 'Active!';
            setTimeout(() => el.saveHubUrlBtn.textContent = 'Save', 2000);
          }
        };

        if (el.addEdgeForm) el.addEdgeForm.addEventListener('submit', handleAddEdge);

        // Playback Events
        if (el.playbackSessionSelect) {
          el.playbackSessionSelect.addEventListener('change', (e) => {
            selectPlaybackSession(e.target.value);
          });
        }

        if (el.refreshSessionsBtn) {
          el.refreshSessionsBtn.addEventListener('click', async () => {
            el.refreshSessionsBtn.textContent = 'Refreshing...';
            await loadPlaybackSessions(false);
            setTimeout(() => {
              if (el.refreshSessionsBtn) el.refreshSessionsBtn.textContent = '🔄 Refresh';
            }, 600);
          });
        }

        if (el.playbackDeviceFilter) {
          el.playbackDeviceFilter.addEventListener('change', (e) => {
            state.selectedPlaybackFilter = e.target.value;
            renderPlaybackGrid();
          });
        }

        if (el.playbackSlider) {
          el.playbackSlider.addEventListener('input', (e) => {
            const idx = parseInt(e.target.value, 10) || 1;
            if (scrubRafId) cancelAnimationFrame(scrubRafId);
            scrubRafId = requestAnimationFrame(() => {
              setPlaybackFrame(idx);
            });
          });
        }

        if (el.btnSyncHub) {
          el.btnSyncHub.addEventListener('click', triggerSyncHub);
        }

        if (el.btnPlayFirst) el.btnPlayFirst.addEventListener('click', () => setPlaybackFrame(1));
        if (el.btnPlayPrev) el.btnPlayPrev.addEventListener('click', () => setPlaybackFrame(state.currentFrameIdx - 1));
        if (el.btnPlayToggle) el.btnPlayToggle.addEventListener('click', togglePlayback);
        if (el.btnPlayNext) el.btnPlayNext.addEventListener('click', () => setPlaybackFrame(state.currentFrameIdx + 1));
        if (el.btnPlayLast) el.btnPlayLast.addEventListener('click', () => setPlaybackFrame(state.maxFrames));

        if (el.playbackSpeedSelect) {
          el.playbackSpeedSelect.addEventListener('change', (e) => {
            state.playbackSpeed = parseFloat(e.target.value) || 1.0;
            if (state.isPlaying) {
              startPlayback();
            }
          });
        }

        // Keyboard controls for frame-by-frame scrubbing
        window.addEventListener('keydown', (e) => {
          if (state.viewMode !== 'playback') return;
          if (e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'SELECT' || e.target.tagName === 'TEXTAREA')) {
            if (e.target.id !== 'playbackSlider') return;
          }
          if (e.code === 'Space') {
            e.preventDefault();
            togglePlayback();
          } else if (e.code === 'ArrowLeft') {
            e.preventDefault();
            setPlaybackFrame(state.currentFrameIdx - 1);
          } else if (e.code === 'ArrowRight') {
            e.preventDefault();
            setPlaybackFrame(state.currentFrameIdx + 1);
          } else if (e.code === 'Home') {
            e.preventDefault();
            setPlaybackFrame(1);
          } else if (e.code === 'End') {
            e.preventDefault();
            setPlaybackFrame(state.maxFrames);
          }
        });
      }

      async function pollData() {
        try {
          const res = await fetch(`${hubBaseUrl}/api/edges`);
          if (!res.ok) throw new Error('Status ' + res.status);
          const data = await res.json();
          state.edges = data.edges || [];
          state.displayEnabled = data.display_enabled;

          updateHUD();
          if (state.viewMode !== 'playback') {
            renderFeeds();
          }
          renderFleetCards();
        } catch (err) {
          const defaultUrl = clientConfig?.default_hub_url || 'https://marvel-reconstruction-atm-planning.trycloudflare.com';
          el.feedsViewport.innerHTML = `
            <div class="empty-state">
              <p>Cannot reach Edge Hub at <code>${escapeHtml(hubBaseUrl)}</code></p>
              <div style="display:flex; gap:8px; justify-content:center; margin-top:12px; flex-wrap:wrap;">
                <button class="submit-btn" onclick="window.setQuickHub('${defaultUrl}')">Connect Default Server Tunnel</button>
                <button class="submit-btn" style="background:rgba(255,255,255,0.1);" onclick="document.getElementById('openMenuBtn').click()">Open Menu / Settings</button>
              </div>
            </div>
          `;
          renderFleetCards();
        }
      }

      function updateHUD() {
        const onlineEdges = state.edges.filter(e => e.online);
        let totalSensors = 0;
        let totalFreeGb = 0;
        onlineEdges.forEach(e => {
          totalSensors += (e.sensors || []).length;
          if (e.collection && e.collection.disk_free_gb !== undefined) {
            totalFreeGb += parseFloat(e.collection.disk_free_gb) || 0;
          }
        });

        if (el.menuEdgeBadge) el.menuEdgeBadge.textContent = onlineEdges.length;
        if (el.menuSensorsCount) el.menuSensorsCount.textContent = totalSensors;
        if (el.menuOnlineEdges) el.menuOnlineEdges.textContent = `${onlineEdges.length}/${state.edges.length}`;
        if (el.menuFreeStorage) el.menuFreeStorage.textContent = totalFreeGb > 0 ? `${totalFreeGb.toFixed(1)} GB` : '--';

        const isAnyRecording = onlineEdges.some(e => e.collection && e.collection.is_recording);
        state.isRecording = isAnyRecording;

        let maxDur = 0;
        if (isAnyRecording) {
          onlineEdges.forEach(e => {
            if (e.collection && e.collection.is_recording) {
              maxDur = Math.max(maxDur, e.collection.duration_seconds || 0);
            }
          });
          const durStr = formatDuration(maxDur);
          if (el.quickRecordBtn) el.quickRecordBtn.classList.add('recording');
          if (el.quickRecordLabel) el.quickRecordLabel.textContent = durStr;
          if (el.menuRecDuration) el.menuRecDuration.textContent = durStr;
          if (el.menuRecStatusLabel) el.menuRecStatusLabel.textContent = 'Recording';
          if (el.menuRecBadge) {
            el.menuRecBadge.textContent = 'RECORDING';
            el.menuRecBadge.style.color = 'var(--accent-red)';
          }
          if (el.modalCollectBtn) el.modalCollectBtn.classList.add('recording');
          if (el.modalCollectBtnText) el.modalCollectBtnText.textContent = 'Stop Recording';
        } else {
          if (el.quickRecordBtn) el.quickRecordBtn.classList.remove('recording');
          if (el.quickRecordLabel) el.quickRecordLabel.textContent = 'REC';
          if (el.menuRecDuration) el.menuRecDuration.textContent = '00:00:00';
          if (el.menuRecStatusLabel) el.menuRecStatusLabel.textContent = 'Standby';
          if (el.menuRecBadge) {
            el.menuRecBadge.textContent = 'IDLE';
            el.menuRecBadge.style.color = '';
          }
          if (el.modalCollectBtn) el.modalCollectBtn.classList.remove('recording');
          if (el.modalCollectBtnText) el.modalCollectBtnText.textContent = 'Start Recording';
        }

        if (el.quickDisplayBtn) {
          el.quickDisplayBtn.classList.toggle('active', state.displayEnabled);
        }
        if (el.quickDisplayLabel) {
          el.quickDisplayLabel.textContent = state.displayEnabled ? 'LIVE' : 'OFF';
        }
      }

      async function toggleDisplay() {
        const newState = !state.displayEnabled;
        try {
          const res = await fetch(`${hubBaseUrl}/api/display/toggle`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ enabled: newState })
          });
          if (res.ok) {
            const d = await res.json();
            state.displayEnabled = d.display_enabled;
            updateHUD();
            renderFeeds();
          }
        } catch (e) {
          console.error(e);
        }
      }

      async function toggleCollection() {
        const endpoint = state.isRecording ? '/api/collection/stop' : '/api/collection/start';
        const label = el.recSessionLabelInput ? el.recSessionLabelInput.value.trim() : 'capture.me.uk Session';
        try {
          await fetch(`${hubBaseUrl}${endpoint}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ label: label || 'capture.me.uk Session' })
          });
          await pollData();
        } catch (e) {
          console.error(e);
        }
      }

      function switchViewMode(mode) {
        state.viewMode = mode;
        if (mode === 'device') {
          if (el.viewByDeviceBtn) el.viewByDeviceBtn.classList.add('active');
          if (el.viewByModalityBtn) el.viewByModalityBtn.classList.remove('active');
          if (el.viewPlaybackBtn) el.viewPlaybackBtn.classList.remove('active');
          if (el.modalityPillsBar) el.modalityPillsBar.style.display = 'none';
          if (el.playbackViewport) el.playbackViewport.style.display = 'none';
          if (el.feedsViewport) el.feedsViewport.style.display = '';
          stopPlayback();
          renderFeeds();
        } else if (mode === 'playback') {
          if (el.viewByDeviceBtn) el.viewByDeviceBtn.classList.remove('active');
          if (el.viewByModalityBtn) el.viewByModalityBtn.classList.remove('active');
          if (el.viewPlaybackBtn) el.viewPlaybackBtn.classList.add('active');
          if (el.modalityPillsBar) el.modalityPillsBar.style.display = 'none';
          if (el.feedsViewport) el.feedsViewport.style.display = 'none';
          if (el.playbackViewport) el.playbackViewport.style.display = 'flex';
          if (!state.playbackSessions || state.playbackSessions.length === 0) {
            loadPlaybackSessions();
          }
        } else {
          // modality mode
          if (el.viewByDeviceBtn) el.viewByDeviceBtn.classList.remove('active');
          if (el.viewByModalityBtn) el.viewByModalityBtn.classList.add('active');
          if (el.viewPlaybackBtn) el.viewPlaybackBtn.classList.remove('active');
          if (el.modalityPillsBar) el.modalityPillsBar.style.display = 'flex';
          if (el.playbackViewport) el.playbackViewport.style.display = 'none';
          if (el.feedsViewport) el.feedsViewport.style.display = '';
          stopPlayback();
          renderFeeds();
        }
      }

      // ==============================================================================
      // Playback Studio & Frame Scrubbing Engine
      // ==============================================================================

      async function loadPlaybackSessions(autoSelectFirst = true) {
        try {
          const res = await fetch(`${hubBaseUrl}/api/recordings/sessions`);
          if (!res.ok) throw new Error('Status ' + res.status);
          const data = await res.json();
          state.playbackSessions = data.sessions || [];

          if (!el.playbackSessionSelect) return;

          if (state.playbackSessions.length === 0) {
            el.playbackSessionSelect.innerHTML = '<option value="">No recorded sessions found</option>';
            if (el.playbackGrid) {
              el.playbackGrid.innerHTML = `
                <div class="empty-state" style="grid-column: 1 / -1; padding: 40px 16px;">
                  <p>No recorded sessions found on connected edge devices.</p>
                  <p style="font-size:0.75rem; color:var(--text-muted); margin-top:8px;">Start a recording from the REC button to create your first session.</p>
                </div>
              `;
            }
            if (el.playbackSessionMetaBadge) el.playbackSessionMetaBadge.textContent = '0 frames • 0s';
            return;
          }

          let html = '';
          state.playbackSessions.forEach(s => {
            const timeFormatted = (s.time || '').replace(/-/g, ':');
            const dur = s.duration_seconds ? `${s.duration_seconds.toFixed(1)}s` : '--';
            const devCount = (s.devices || []).length;
            html += `<option value="${escapeHtml(s.id)}">${escapeHtml(s.date)} ${escapeHtml(timeFormatted)} • ${escapeHtml(s.label || 'Session')} • ${s.max_frames} frames (${dur}, ${devCount} devs)</option>`;
          });
          el.playbackSessionSelect.innerHTML = html;

          if (autoSelectFirst || !state.currentSession) {
            selectPlaybackSession(state.playbackSessions[0].id);
          } else {
            const exists = state.playbackSessions.some(s => s.id === state.currentSession.id);
            if (exists) {
              el.playbackSessionSelect.value = state.currentSession.id;
            } else {
              selectPlaybackSession(state.playbackSessions[0].id);
            }
          }
        } catch (err) {
          console.error('Error loading playback sessions:', err);
          if (el.playbackSessionSelect) {
            el.playbackSessionSelect.innerHTML = '<option value="">Failed to fetch sessions from Hub</option>';
          }
        }
      }

      // ==============================================================================
      // Playback Studio & Frame Scrubbing Engine (In-Memory Buffer + Frame-Paced Playback)
      // ==============================================================================

      const frameCache = new Map(); // key: `${deviceId}:${modality}:${devIdx}` -> blob URL
      let prebufferAbort = false;
      let prebufferRunning = false;
      let playbackAnimFrameId = null;
      let lastFrameTime = 0;
      let scrubRafId = null;
      let syncPollingInterval = null;

      async function getOrFetchFrame(devId, date, time, mod, devIdx) {
        const key = `${devId}:${mod}:${devIdx}`;
        if (frameCache.has(key)) {
          return frameCache.get(key);
        }
        const url = `${hubBaseUrl}/proxy/recording/${devId}/${date}/${time}/${mod}/${devIdx}`;
        try {
          const res = await fetch(url);
          if (res.ok) {
            const blob = await res.blob();
            const blobUrl = URL.createObjectURL(blob);
            frameCache.set(key, blobUrl);
            updateBufferStats();
            return blobUrl;
          }
        } catch (e) {
          // fetch error fallback
        }
        return url;
      }

      function updateBufferStats() {
        if (!state.currentSession) return;
        const session = state.currentSession;
        let totalNeeded = 0;
        let totalCached = 0;

        (session.devices || []).forEach(dev => {
          (dev.modalities || []).forEach(mod => {
            const fcount = mod.frames_count || state.maxFrames;
            totalNeeded += fcount;
            for (let i = 1; i <= fcount; i++) {
              if (frameCache.has(`${dev.device_id}:${mod.id}:${i}`)) {
                totalCached++;
              }
            }
          });
        });

        const pct = totalNeeded > 0 ? Math.min(100, Math.round((totalCached / totalNeeded) * 100)) : 0;
        if (el.playbackBufferBar) {
          el.playbackBufferBar.style.width = `${pct}%`;
        }
        if (el.playbackBufferBadge) {
          if (pct >= 100) {
            el.playbackBufferBadge.textContent = `RAM: 100% (${totalCached}f Ready)`;
            el.playbackBufferBadge.classList.add('cached');
          } else {
            el.playbackBufferBadge.textContent = `RAM: ${pct}% (${totalCached}/${totalNeeded})`;
            el.playbackBufferBadge.classList.remove('cached');
          }
        }
      }

      async function startPrebuffering() {
        if (!state.currentSession) return;
        prebufferAbort = false;
        if (prebufferRunning) return;
        prebufferRunning = true;

        const session = state.currentSession;
        const streams = [];
        (session.devices || []).forEach(dev => {
          (dev.modalities || []).forEach(mod => {
            streams.push({ dev, mod });
          });
        });

        const maxFrames = state.maxFrames;
        const frameIndices = [];
        for (let i = state.currentFrameIdx; i <= maxFrames; i++) frameIndices.push(i);
        for (let i = 1; i < state.currentFrameIdx; i++) frameIndices.push(i);

        let queueIdx = 0;
        const concurrency = 4;

        async function prebufferWorker() {
          while (queueIdx < frameIndices.length && !prebufferAbort) {
            const fNum = frameIndices[queueIdx++];
            for (const { dev, mod } of streams) {
              if (prebufferAbort) break;
              const cardMax = mod.frames_count || maxFrames;
              const devIdx = Math.max(1, Math.min(fNum, cardMax));
              const key = `${dev.device_id}:${mod.id}:${devIdx}`;
              if (!frameCache.has(key)) {
                await getOrFetchFrame(dev.device_id, dev.date, dev.time, mod.id, devIdx);
              }
            }
          }
        }

        const workers = Array.from({ length: concurrency }, () => prebufferWorker());
        await Promise.all(workers);
        prebufferRunning = false;
        updateBufferStats();
      }

      async function triggerSyncHub() {
        if (!state.currentSession) return;
        const sessionId = state.currentSession.id;
        if (!el.btnSyncHub) return;

        el.btnSyncHub.textContent = '⏳ Starting Cache...';
        try {
          const res = await fetch(`${hubBaseUrl}/api/recordings/${sessionId}/cache-all`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({})
          });
          if (res.ok) {
            if (syncPollingInterval) clearInterval(syncPollingInterval);
            syncPollingInterval = setInterval(async () => {
              try {
                const sres = await fetch(`${hubBaseUrl}/api/recordings/${sessionId}/cache-status`);
                if (sres.ok) {
                  const sdata = await sres.json();
                  if (sdata.done) {
                    clearInterval(syncPollingInterval);
                    syncPollingInterval = null;
                    el.btnSyncHub.textContent = '✅ Cached on PC';
                    el.btnSyncHub.style.borderColor = 'var(--accent-cyan)';
                    startPrebuffering();
                  } else if (sdata.in_progress) {
                    el.btnSyncHub.textContent = `💾 PC: ${sdata.percent}% (${sdata.cached}/${sdata.total})`;
                  }
                }
              } catch (e) {}
            }, 750);
          }
        } catch (err) {
          el.btnSyncHub.textContent = '❌ Sync Failed';
          setTimeout(() => { if (el.btnSyncHub) el.btnSyncHub.textContent = '💾 Cache to PC'; }, 2000);
        }
      }

      async function checkHubCacheStatus(sessionId) {
        if (!el.btnSyncHub) return;
        try {
          const res = await fetch(`${hubBaseUrl}/api/recordings/${sessionId}/cache-status`);
          if (res.ok) {
            const data = await res.json();
            if (data.done || data.percent >= 100) {
              el.btnSyncHub.textContent = '✅ Cached on PC';
              el.btnSyncHub.style.borderColor = 'var(--accent-cyan)';
            } else {
              el.btnSyncHub.textContent = '💾 Cache to PC';
              el.btnSyncHub.style.borderColor = '';
            }
          }
        } catch (e) {}
      }

      function selectPlaybackSession(sessionId) {
        const session = state.playbackSessions.find(s => s.id === sessionId);
        if (!session) return;

        prebufferAbort = true;
        frameCache.clear();
        updateBufferStats();

        state.currentSession = session;
        state.maxFrames = Math.max(1, session.max_frames || 1);
        state.currentFrameIdx = 1;

        if (el.playbackSessionSelect) el.playbackSessionSelect.value = sessionId;

        // Populate device filter
        if (el.playbackDeviceFilter) {
          let filterHtml = '<option value="all">Synchronized Fleet Grid (All Devices & Streams)</option>';
          (session.devices || []).forEach(dev => {
            (dev.modalities || []).forEach(mod => {
              const fKey = `${dev.device_id}:${mod.id}`;
              filterHtml += `<option value="${escapeHtml(fKey)}">${escapeHtml(dev.device_name || dev.device_id)} • ${escapeHtml(mod.name || mod.id)} (${mod.frames_count || 0} frames)</option>`;
            });
          });
          el.playbackDeviceFilter.innerHTML = filterHtml;
          state.selectedPlaybackFilter = 'all';
        }

        // Update meta badge
        if (el.playbackSessionMetaBadge) {
          const dur = session.duration_seconds ? `${session.duration_seconds.toFixed(1)}s` : '--';
          const devCount = (session.devices || []).length;
          el.playbackSessionMetaBadge.textContent = `${state.maxFrames} frames • ${dur} • ${devCount} devices`;
        }

        // Setup scrubber slider
        if (el.playbackSlider) {
          el.playbackSlider.min = '1';
          el.playbackSlider.max = String(state.maxFrames);
          el.playbackSlider.value = '1';
        }

        stopPlayback();
        renderPlaybackGrid();
        updatePlaybackHUD();
        checkHubCacheStatus(sessionId);
        startPrebuffering();
      }

      function renderPlaybackGrid() {
        if (!el.playbackGrid || !state.currentSession) return;

        const session = state.currentSession;
        const streams = [];

        (session.devices || []).forEach(dev => {
          (dev.modalities || []).forEach(mod => {
            const fKey = `${dev.device_id}:${mod.id}`;
            if (state.selectedPlaybackFilter !== 'all' && state.selectedPlaybackFilter !== fKey) {
              return;
            }
            streams.push({ dev, mod });
          });
        });

        if (streams.length === 0) {
          el.playbackGrid.innerHTML = `
            <div class="empty-state" style="grid-column: 1 / -1; padding: 36px 16px;">
              <p>No streams match the selected filter.</p>
            </div>
          `;
          return;
        }

        let html = '';
        streams.forEach(({ dev, mod }) => {
          const modType = (mod.modality || 'rgb').toLowerCase();
          const maxCount = mod.frames_count || state.maxFrames;
          const initialFrame = Math.max(1, Math.min(state.currentFrameIdx, maxCount));
          const key = `${dev.device_id}:${mod.id}:${initialFrame}`;
          const initialUrl = frameCache.get(key) || `${hubBaseUrl}/proxy/recording/${dev.device_id}/${dev.date}/${dev.time}/${mod.id}/${initialFrame}`;

          html += `
            <div class="playback-card"
                 data-device-id="${escapeHtml(dev.device_id)}"
                 data-date="${escapeHtml(dev.date)}"
                 data-time="${escapeHtml(dev.time)}"
                 data-modality="${escapeHtml(mod.id)}"
                 data-max-frames="${maxCount}">
              <div class="playback-card-header">
                <div class="playback-card-title">
                  <span class="status-indicator"></span>
                  <span style="font-weight:700;">${escapeHtml(dev.device_name || dev.device_id)}</span>
                  <span class="device-id-tag">${escapeHtml(dev.device_id)}</span>
                </div>
                <span class="playback-card-modality ${modType}">${escapeHtml(mod.modality || modType).toUpperCase()}</span>
              </div>
              
              <div class="playback-card-body">
                <img src="${initialUrl}" alt="${escapeHtml(mod.name || mod.id)}" class="playback-frame-img" loading="eager" />
              </div>

              <div class="playback-card-footer">
                <span style="color:var(--text-main); font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;" title="${escapeHtml(mod.name || mod.id)}">${escapeHtml(mod.name || mod.id)}</span>
                <span class="card-frame-badge">Frame ${initialFrame} / ${maxCount}</span>
              </div>
            </div>
          `;
        });

        el.playbackGrid.innerHTML = html;
      }

      function setPlaybackFrame(idx) {
        if (!state.currentSession) return;
        idx = Math.max(1, Math.min(idx, state.maxFrames));
        state.currentFrameIdx = idx;

        if (el.playbackSlider) el.playbackSlider.value = String(idx);
        updatePlaybackHUD();

        const cards = document.querySelectorAll('.playback-card');
        cards.forEach(card => {
          const devId = card.dataset.deviceId;
          const date = card.dataset.date;
          const time = card.dataset.time;
          const mod = card.dataset.modality;
          const cardMax = parseInt(card.dataset.maxFrames, 10) || state.maxFrames;
          const devIdx = Math.max(1, Math.min(idx, cardMax));
          const key = `${devId}:${mod}:${devIdx}`;

          const img = card.querySelector('.playback-frame-img');
          if (img) {
            if (frameCache.has(key)) {
              img.src = frameCache.get(key);
            } else {
              const directUrl = `${hubBaseUrl}/proxy/recording/${devId}/${date}/${time}/${mod}/${devIdx}`;
              img.src = directUrl;
              getOrFetchFrame(devId, date, time, mod, devIdx);
            }
          }

          const badge = card.querySelector('.card-frame-badge');
          if (badge) {
            badge.textContent = `Frame ${devIdx} / ${cardMax}`;
          }
        });
      }

      function updatePlaybackHUD() {
        if (el.playbackHudFrame) {
          el.playbackHudFrame.textContent = `${state.currentFrameIdx} / ${state.maxFrames}`;
        }
        if (el.playbackHudTime) {
          const currentSec = (state.currentFrameIdx - 1) / 10.0;
          const totalSec = state.currentSession?.duration_seconds || (state.maxFrames / 10.0);
          el.playbackHudTime.textContent = `+${formatTimeSec(currentSec)} / ${formatTimeSec(totalSec)}`;
        }
      }

      function formatTimeSec(seconds) {
        const s = Math.max(0, seconds);
        const mins = Math.floor(s / 60).toString().padStart(2, '0');
        const secs = (s % 60).toFixed(1).padStart(4, '0');
        return `${mins}:${secs}s`;
      }

      function togglePlayback() {
        if (state.isPlaying) {
          stopPlayback();
        } else {
          if (state.currentFrameIdx >= state.maxFrames) {
            setPlaybackFrame(1);
          }
          startPlayback();
        }
      }

      function playbackLoop(timestamp) {
        if (!state.isPlaying) return;

        const baseFps = 10;
        const targetFps = baseFps * state.playbackSpeed;
        const frameIntervalMs = 1000 / targetFps;

        if (!lastFrameTime) lastFrameTime = timestamp;
        const elapsed = timestamp - lastFrameTime;

        if (elapsed >= frameIntervalMs) {
          lastFrameTime = timestamp - (elapsed % frameIntervalMs);
          const nextIdx = (state.currentFrameIdx >= state.maxFrames) ? 1 : state.currentFrameIdx + 1;
          setPlaybackFrame(nextIdx);
        }

        if (state.isPlaying) {
          playbackAnimFrameId = requestAnimationFrame(playbackLoop);
        }
      }

      function startPlayback() {
        stopPlayback();
        state.isPlaying = true;
        if (el.btnPlayToggle) {
          el.btnPlayToggle.textContent = '⏸';
          el.btnPlayToggle.classList.add('playing');
        }
        lastFrameTime = 0;
        playbackAnimFrameId = requestAnimationFrame(playbackLoop);
      }

      function stopPlayback() {
        state.isPlaying = false;
        if (el.btnPlayToggle) {
          el.btnPlayToggle.textContent = '▶';
          el.btnPlayToggle.classList.remove('playing');
        }
        if (playbackAnimFrameId) {
          cancelAnimationFrame(playbackAnimFrameId);
          playbackAnimFrameId = null;
        }
      }

      function renderFeeds() {
        if (state.edges.length === 0) {
          el.feedsViewport.innerHTML = `
            <div class="empty-state">
              <p>No edge devices configured.</p>
              <button class="submit-btn" onclick="window.switchModalTab('add'); el.modalBackdrop.classList.add('open');">+ Add Edge Device</button>
            </div>
          `;
          return;
        }

        if (state.viewMode === 'device') {
          renderByDevice();
        } else {
          renderByModality();
        }
      }

      function renderByDevice() {
        let html = '<div class="devices-grid">';
        state.edges.forEach(edge => {
          const isOnline = edge.online;
          const sensors = edge.sensors || [];
          const col = edge.collection || {};
          const isRec = col.is_recording;
          const freeGb = col.disk_free_gb !== undefined ? `${col.disk_free_gb} GB` : 'Ready';
          const isSingle = sensors.length <= 1;

          html += `
            <div class="device-card ${isSingle ? 'single-sensor' : 'multi-sensor'}" id="card-${edge.device_id}">
              <div class="device-card-header">
                <div class="device-card-title">
                  <div class="status-indicator ${isOnline ? '' : 'offline'}"></div>
                  <span class="device-name" title="${escapeHtml(edge.device_name || edge.device_id)}">${escapeHtml(edge.device_name || edge.device_id)}</span>
                  <span class="device-id-tag">${escapeHtml(edge.device_id)}</span>
                </div>
                <div class="device-telemetry">
                  ${isRec ? `<span class="rec-pulse-chip">⏺ ${col.duration_seconds || 0}s</span>` : ''}
                  <span class="storage-badge" title="SD Free: ${freeGb}">💾 ${freeGb}</span>
                </div>
              </div>
              
              <div class="${isSingle ? 'device-single-body' : 'sensors-grid'}">
                ${sensors.length > 0 ? sensors.map(s => renderSensorBox(edge, s, false)).join('') : `
                  <div class="empty-state" style="padding: 16px;">
                    <p style="font-size: 0.75rem;">${isOnline ? 'No sensors reported' : 'Edge device offline'}</p>
                  </div>
                `}
              </div>
            </div>
          `;
        });
        html += '</div>';
        el.feedsViewport.innerHTML = html;
      }

      function renderByModality() {
        const modalitiesMap = {};
        state.edges.forEach(edge => {
          if (!edge.online) return;
          (edge.sensors || []).forEach(sensor => {
            const mod = (sensor.modality || 'other').toLowerCase();
            if (state.selectedModalityFilter !== 'all' && mod !== state.selectedModalityFilter) return;
            if (!modalitiesMap[mod]) modalitiesMap[mod] = [];
            modalitiesMap[mod].push({ edge, sensor });
          });
        });

        const modalities = Object.keys(modalitiesMap);
        if (modalities.length === 0) {
          el.feedsViewport.innerHTML = `
            <div class="empty-state">
              <p>No sensor feeds found for filter: <strong>${escapeHtml(state.selectedModalityFilter.toUpperCase())}</strong></p>
            </div>
          `;
          return;
        }

        let html = '';
        modalities.forEach(mod => {
          const items = modalitiesMap[mod];
          html += `
            <div class="modality-group-section">
              <div class="modality-section-header">
                <span class="feed-modality-badge modality-${mod}">${mod}</span>
                <span class="modality-section-title">${mod.toUpperCase()} Feeds (${items.length})</span>
              </div>
              <div class="sensors-grid">
                ${items.map(item => renderSensorBox(item.edge, item.sensor, true)).join('')}
              </div>
            </div>
          `;
        });
        el.feedsViewport.innerHTML = html;
      }

      function renderSensorBox(edge, sensor, showDeviceTag = false) {
        const streamUrl = `${hubBaseUrl}/proxy/stream/${edge.device_id}/${sensor.id || sensor.modality}`;
        const mod = (sensor.modality || 'rgb').toLowerCase();
        const isRec = edge.collection && edge.collection.is_recording;
        const frameCount = (edge.collection && edge.collection.frame_counts && edge.collection.frame_counts[sensor.id]) || 0;

        return `
          <div class="feed-box" id="sensor-${edge.device_id}-${sensor.id}">
            <div class="feed-box-header">
              <div style="display:flex; align-items:center; gap:6px; overflow:hidden;">
                <span class="feed-modality-badge modality-${mod}">${mod}</span>
                <span class="feed-name" title="${escapeHtml(sensor.name || sensor.id)}">${escapeHtml(sensor.name || sensor.id)}</span>
              </div>
              ${showDeviceTag ? `<span class="device-id-tag" title="${escapeHtml(edge.device_name || edge.device_id)}">${escapeHtml(edge.device_name || edge.device_id)}</span>` : ''}
            </div>

            <div class="feed-screen">
              ${state.displayEnabled && edge.online ? `
                <img src="${streamUrl}" alt="${sensor.name}" loading="lazy">
              ` : `
                <div class="display-off-overlay">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                    <line x1="1" y1="1" x2="23" y2="23"></line>
                  </svg>
                  <span>${!edge.online ? 'Edge Offline' : 'Display Off'}</span>
                </div>
              `}
            </div>

            <div class="feed-footer">
              <span>${sensor.resolution || '640x480'} @ ${sensor.fps || 15}fps</span>
              <span>${isRec ? `<span class="rec-pulse-chip">⏺ #${frameCount}</span>` : 'READY'}</span>
            </div>
          </div>
        `;
      }

      function timeAgo(ts) {
        if (!ts) return 'Never';
        const diffSec = Math.floor(Date.now() / 1000 - ts);
        if (diffSec < 5) return 'Just now';
        if (diffSec < 60) return `${diffSec}s ago`;
        if (diffSec < 3600) return `${Math.floor(diffSec / 60)}m ago`;
        return `${Math.floor(diffSec / 3600)}h ago`;
      }

      window.focusDeviceFeed = function (deviceId) {
        el.modalBackdrop.classList.remove('open');
        if (state.viewMode !== 'device') switchViewMode('device');
        setTimeout(() => {
          const card = document.getElementById('card-' + deviceId);
          if (card) {
            card.scrollIntoView({ behavior: 'smooth', block: 'center' });
            card.style.outline = '2px solid var(--accent-cyan)';
            setTimeout(() => card.style.outline = '', 2000);
          }
        }, 150);
      };

      function renderFleetCards() {
        if (!el.fleetCardsContainer) return;

        const total = state.edges.length;
        const online = state.edges.filter(e => e.online).length;

        if (el.modalFleetBadge) el.modalFleetBadge.textContent = `${online}/${total}`;
        if (el.summaryTotalEdges) el.summaryTotalEdges.textContent = total;
        if (el.summaryOnlineEdges) el.summaryOnlineEdges.textContent = online;

        if (state.edges.length === 0) {
          el.fleetCardsContainer.innerHTML = `
            <div class="empty-state" style="padding: 24px;">
              <p>No edge devices registered in fleet yet.</p>
              <button class="submit-btn" style="margin-top: 10px;" onclick="window.switchModalTab('add')">+ Register First Device</button>
            </div>
          `;
          return;
        }

        el.fleetCardsContainer.innerHTML = state.edges.map(edge => {
          const isOnline = Boolean(edge.online);
          const net = edge.network || {};
          let netLabel = edge.host ? `${edge.host}:${edge.port}` : 'Default';
          let netIcon = '🌐';
          if (net.type === 'hotspot') {
            netIcon = '📱';
            netLabel = `Hotspot (${escapeHtml(net.ssid || 'Wi-Fi')}) • ${escapeHtml(net.ip || edge.host)}`;
          } else if (net.type === '5g') {
            netIcon = '📶';
            netLabel = `5G Cellular (${escapeHtml(net.interface || 'wwan0')}) • ${escapeHtml(net.ip || edge.host)}`;
          } else if (net.type === 'ethernet') {
            netIcon = '🔌';
            netLabel = `Ethernet (${escapeHtml(net.ip || edge.host)})`;
          }

          const sensors = edge.sensors || [];
          const sensorDesc = sensors.length > 0 
            ? sensors.map(s => `${escapeHtml(s.name || s.id)} (${s.resolution || '640x600'} @ ${s.fps || 15}fps)`).join(', ')
            : 'No sensors detected';

          const col = edge.collection || {};
          const storageDesc = col.disk_free_gb !== undefined 
            ? `${col.disk_free_gb} GB free of ${col.disk_total_gb || '--'} GB`
            : 'SD Card storage ready';

          const latency = edge.latency_ms ? `${edge.latency_ms} ms ping` : 'Active';
          const lastSeenStr = edge.last_seen 
            ? timeAgo(edge.last_seen)
            : 'Never';

          return `
            <div class="fleet-device-card ${isOnline ? 'online' : 'offline'}">
              <div class="fleet-card-top">
                <div class="fleet-device-title-group">
                  <span class="fleet-device-name">
                    <span class="status-indicator ${isOnline ? '' : 'offline'}"></span>
                    ${escapeHtml(edge.device_name || edge.device_id)}
                  </span>
                  <span class="fleet-device-id">ID: <code>${escapeHtml(edge.device_id)}</code> &bull; Host: <code>${escapeHtml(edge.host)}:${edge.port}</code></span>
                </div>
                <div class="fleet-status-badge ${isOnline ? 'online' : 'offline'}">
                  ${isOnline ? `🟢 AVAILABLE (${latency})` : `⚪ OFFLINE (${lastSeenStr})`}
                </div>
              </div>

              <div class="fleet-details-grid">
                <div class="fleet-detail-item">
                  <span>${netIcon}</span>
                  <span><strong>Connection:</strong> ${netLabel}</span>
                </div>
                <div class="fleet-detail-item">
                  <span>📷</span>
                  <span><strong>Sensors:</strong> ${sensorDesc}</span>
                </div>
                <div class="fleet-detail-item">
                  <span>💾</span>
                  <span><strong>Storage:</strong> ${storageDesc}</span>
                </div>
                <div class="fleet-detail-item">
                  <span>⏱️</span>
                  <span><strong>Status:</strong> ${isOnline ? (col.is_recording ? `Recording (#${col.duration_seconds || 0}s)` : 'Standby / Ready') : 'Unreachable'}</span>
                </div>
              </div>

              <div class="fleet-card-actions">
                ${isOnline ? `
                  <button class="btn-action-view" onclick="window.focusDeviceFeed('${edge.device_id}')">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                      <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    View Feed
                  </button>
                ` : ''}
                <button class="btn-action-remove" onclick="window.removeEdgeDevice('${edge.device_id}')">
                  Remove Device
                </button>
              </div>
            </div>
          `;
        }).join('');
      }

      async function handleAddEdge(e) {
        e.preventDefault();
        const payload = {
          device_id: el.edgeIdInput.value.trim(),
          device_name: el.edgeNameInput.value.trim(),
          host: el.edgeHostInput.value.trim(),
          port: parseInt(el.edgePortInput.value.trim(), 10) || 5001
        };

        try {
          const res = await fetch(`${hubBaseUrl}/api/edges`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          if (res.ok) {
            el.addEdgeForm.reset();
            await pollData();
          }
        } catch (err) {
          alert('Failed to add edge device: ' + err);
        }
      }

      window.removeEdgeDevice = async function(deviceId) {
        if (!confirm(`Remove edge device "${deviceId}"?`)) return;
        try {
          await fetch(`${hubBaseUrl}/api/edges/${deviceId}`, { method: 'DELETE' });
          await pollData();
        } catch (err) {
          alert('Failed to remove edge: ' + err);
        }
      };

      function formatDuration(sec) {
        const s = Math.floor(sec);
        const hrs = Math.floor(s / 3600).toString().padStart(2, '0');
        const mins = Math.floor((s % 3600) / 60).toString().padStart(2, '0');
        const secs = (s % 60).toString().padStart(2, '0');
        return `${hrs}:${mins}:${secs}`;
      }

      function escapeHtml(str) {
        if (!str) return '';
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      document.addEventListener('DOMContentLoaded', init);
    })();
  </script>
</body>
</html>

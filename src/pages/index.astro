      function startTimedLiveStream(durationSec) {
        if (state.streamTimerInterval) clearInterval(state.streamTimerInterval);
        state.liveStreamingActive = true;
        state.streamTimeRemaining = durationSec || 10;

        if (el.quickDisplayBtn) el.quickDisplayBtn.classList.add('live-streaming');
        if (el.quickDisplayLabel) el.quickDisplayLabel.textContent = `LIVE (${state.streamTimeRemaining}s)`;

        updateSensorFeedSources();

        state.streamTimerInterval = setInterval(() => {
          state.streamTimeRemaining--;
          if (state.streamTimeRemaining <= 0) {
            stopTimedLiveStream();
          } else {
            if (el.quickDisplayLabel) el.quickDisplayLabel.textContent = `LIVE (${state.streamTimeRemaining}s)`;
            document.querySelectorAll('.live-stream-badge-overlay span:last-child').forEach(s => {
              s.textContent = `LIVE (${state.streamTimeRemaining}s)`;
            });
          }
        }, 1000);
      }

      function stopTimedLiveStream() {
        if (state.streamTimerInterval) {
          clearInterval(state.streamTimerInterval);
          state.streamTimerInterval = null;
        }
        state.liveStreamingActive = false;
        state.streamTimeRemaining = 0;

        const now = Date.now();
        state.edges.forEach(edge => {
          (edge.sensors || []).forEach(sensor => {
            const target = sensor.id || sensor.modality;
            state.snapshotTimestamps[`${edge.device_id}:${target}`] = now;
          });
        });

        if (el.quickDisplayBtn) el.quickDisplayBtn.classList.remove('live-streaming');
        if (el.quickDisplayLabel) el.quickDisplayLabel.textContent = `Live (${state.selectedStreamDuration || 10}s)`;

        updateSensorFeedSources();
      }

      window.requestAllSnapshots = async function () {
        if (el.snapshotBtnLabel) el.snapshotBtnLabel.textContent = 'Fetching...';
        const now = Date.now();
        state.edges.forEach(edge => {
          if (!edge.online) return;
          (edge.sensors || []).forEach(sensor => {
            const target = sensor.id || sensor.modality;
            const fKey = `${edge.device_id}:${target}`;
            state.snapshotTimestamps[fKey] = now;
            const img = document.getElementById(`feed-img-${edge.device_id}-${target}`);
            if (img && !state.liveStreamingActive) {
              img.src = getSnapshotUrl(edge, target, now);
            }
          });
        });
        updateRelativeTimestamps();
        setTimeout(() => {
          if (el.snapshotBtnLabel) el.snapshotBtnLabel.textContent = 'Snapshot';
        }, 800);
      };

      window.requestSensorSnapshot = async function (deviceId, target, ev) {
        if (ev) ev.stopPropagation();
        const now = Date.now();
        const fKey = `${deviceId}:${target}`;
        state.snapshotTimestamps[fKey] = now;
        const btn = document.getElementById(`live-btn-${deviceId}-${target}`);
        if (btn) btn.classList.add('refreshing');
        const img = document.getElementById(`feed-img-${deviceId}-${target}`);
        if (img) {
          const edge = state.edges.find(e => e.device_id === deviceId);
          img.src = getSnapshotUrl(edge || { device_id: deviceId }, target, now);
          img.onload = () => { if (btn) btn.classList.remove('refreshing'); };
          img.onerror = () => { if (btn) btn.classList.remove('refreshing'); };
        }
        setTimeout(() => { if (btn) btn.classList.remove('refreshing'); }, 1200);
        updateRelativeTimestamps();
      };

      window.toggleSensorFullscreen = function (deviceId, sensorId, target, ev) {
        if (ev && ev.target && ev.target.closest('button')) return;
        const box = document.getElementById(`sensor-${deviceId}-${sensorId}`);
        if (!box) return;

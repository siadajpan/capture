      window.toggleSensorLive = function (deviceId, target, ev) {
        if (ev) ev.stopPropagation();
        if (!state.sensorLiveTimers) state.sensorLiveTimers = {};
        if (!state.sensorLiveRemaining) state.sensorLiveRemaining = {};
        const fKey = `${deviceId}:${target}`;

        if (state.liveStreamingActive) {
          stopTimedLiveStream();
          return;
        }

        if (state.sensorLiveTimers[fKey]) {
          clearInterval(state.sensorLiveTimers[fKey]);
          delete state.sensorLiveTimers[fKey];
          delete state.sensorLiveRemaining[fKey];
          state.snapshotTimestamps[fKey] = Date.now();
          updateSensorFeedSources();
          return;
        }

        const dur = state.selectedStreamDuration || 10;
        state.sensorLiveRemaining[fKey] = dur;
        updateSensorFeedSources();

        state.sensorLiveTimers[fKey] = setInterval(() => {
          state.sensorLiveRemaining[fKey] = (state.sensorLiveRemaining[fKey] || 1) - 1;
          if (state.sensorLiveRemaining[fKey] <= 0) {
            clearInterval(state.sensorLiveTimers[fKey]);
            delete state.sensorLiveTimers[fKey];
            delete state.sensorLiveRemaining[fKey];
            state.snapshotTimestamps[fKey] = Date.now();
            updateSensorFeedSources();
          } else {
            const rem = state.sensorLiveRemaining[fKey];
            const badge = document.getElementById(`badge-${deviceId}-${target}`);
            if (badge) {
              badge.className = 'live-stream-badge-overlay';

        if (el.btnPlayNext) el.btnPlayNext.addEventListener('click', () => {
          if (state.timeSyncEnabled) seekToTime(state.currentTimeSec + 0.1);
          else setPlaybackFrame(state.currentFrameIdx + 1);
        });
        if (el.btnPlayLast) el.btnPlayLast.addEventListener('click', () => {

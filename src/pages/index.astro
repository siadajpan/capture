        if (el.btnPlayPrev) el.btnPlayPrev.addEventListener('click', () => {
          if (state.timeSyncEnabled) seekToTime(state.currentTimeSec - 0.1);
          else setPlaybackFrame(state.currentFrameIdx - 1);

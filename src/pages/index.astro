        // Keyboard controls for frame-by-frame scrubbing
        window.addEventListener('keydown', (e) => {
          if (state.viewMode !== 'playback') return;
          if (e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'SELECT' || e.target.tagName === 'TEXTAREA')) {
            if (e.target.id !== 'playbackSlider') return;
          }
          if (e.code === 'Space') {
            e.preventDefault();
            togglePlayback();
          } else if (e.code === 'ArrowLeft') {
            e.preventDefault();
            if (state.timeSyncEnabled) seekToTime(state.currentTimeSec - 0.1);
            else setPlaybackFrame(state.currentFrameIdx - 1);
          } else if (e.code === 'ArrowRight') {
            e.preventDefault();
            if (state.timeSyncEnabled) seekToTime(state.currentTimeSec + 0.1);
            else setPlaybackFrame(state.currentFrameIdx + 1);
          } else if (e.code === 'Home') {
            e.preventDefault();
            if (state.timeSyncEnabled) seekToTime(0);
            else setPlaybackFrame(1);
          } else if (e.code === 'End') {
            e.preventDefault();
            if (state.timeSyncEnabled) seekToTime(state.commonDuration);
            else setPlaybackFrame(state.maxFrames);
          }
        });
      }

      async function pollData() {
        const configuredNodes = (clientConfig && clientConfig.fleet_nodes && clientConfig.fleet_nodes.length > 0)
          ? clientConfig.fleet_nodes
          : FLEET_NODE_DEFAULTS;

        const queryTargets = [...configuredNodes];
        if (hubBaseUrl && !queryTargets.some(n => n.url === hubBaseUrl)) {
          queryTargets.push({ id: 'custom-hub', name: 'Custom Hub', url: hubBaseUrl });
        }

        try {
          const results = await Promise.allSettled(
            queryTargets.map(async node => {
              const controller = new AbortController();
              const timeoutId = setTimeout(() => controller.abort(), 3000);
              try {
                // Try /api/status first (native fast response on all edge nodes)
                const res = await fetch(`${node.url}/api/status`, { signal: controller.signal });
                clearTimeout(timeoutId);
                if (res.ok) {
                  const statusData = await res.json();
                  return {
                    node,
                    data: {
                      display_enabled: true,
                      edges: [{
                        ...statusData,
                        is_gateway: true,
                        online: true,
                        last_seen: Date.now() / 1000
                      }]
                    }
                  };
                }
              } catch (_) {
                clearTimeout(timeoutId);
              }

              // Fallback to /api/edges if it's a hub gateway
              try {
                const c2 = new AbortController();
                const t2 = setTimeout(() => c2.abort(), 2500);
                const res2 = await fetch(`${node.url}/api/edges`, { signal: c2.signal });
                clearTimeout(t2);
                if (res2.ok) {
                  const data = await res2.json();
                  return { node, data };
                }
              } catch (_) {}

              throw new Error(`Node ${node.id} unreachable`);
            })
          );

          let anySuccess = false;
          const mergedEdges = new Map();

          results.forEach(r => {
            if (r.status === 'fulfilled' && r.value && r.value.data) {
              anySuccess = true;
              const { node, data } = r.value;
              if (data.display_enabled !== undefined) {
                state.displayEnabled = data.display_enabled;
              }
              const edgeList = Array.isArray(data.edges) ? data.edges : [];
              edgeList.forEach(edge => {
                if (!edge || !edge.device_id) return;
                if (edge.device_id === node.id || (!edge.tunnel_url && edgeList.length === 1)) {
                  edge.tunnel_url = node.url;
                }
                const existing = mergedEdges.get(edge.device_id);
                if (!existing) {
                  mergedEdges.set(edge.device_id, edge);
                } else {
                  if (!existing.tunnel_url && edge.tunnel_url) {
                    mergedEdges.set(edge.device_id, edge);
                  } else if (edge.online && !existing.online) {
                    mergedEdges.set(edge.device_id, edge);
                  }
                }
              });
            }
          });

          configuredNodes.forEach(node => {
            if (!mergedEdges.has(node.id)) {
              mergedEdges.set(node.id, {
                device_id: node.id,
                device_name: node.name || node.id,
                online: false,
                tunnel_url: node.url,
                sensors: [],
                modalities: []
              });
            }
          });

          if (!anySuccess) {
            throw new Error('All fleet tunnel queries failed');
          }

          state.edges = Array.from(mergedEdges.values());
          state.pollFailCount = 0;

          updateHUD();
          if (state.viewMode !== 'playback') {
            renderFeeds();
          }
          renderFleetCards();
        } catch (err) {
          console.warn('Fleet poll warning (cellular jitter):', err);
          state.pollFailCount = (state.pollFailCount || 0) + 1;

          if (el.fleetHealthPill && el.fleetHealthText) {
            el.fleetHealthPill.className = 'fleet-health-pill reconnecting';
            el.fleetHealthText.textContent = `⚠️ Syncing (${state.pollFailCount})...`;
          }

          if ((!state.edges || state.edges.length === 0) && state.pollFailCount >= 2) {
            const defaultUrl = clientConfig?.default_hub_url || 'https://fleet.capture.me.uk';
            el.feedsViewport.innerHTML = `
              <div class="empty-state">
                <p>Cannot reach Edge Hubs or Tunnels</p>
                <div style="display:flex; gap:8px; justify-content:center; margin-top:12px; flex-wrap:wrap;">
                  <button class="submit-btn" onclick="window.setQuickHub('${defaultUrl}')">Connect Default Server Tunnel</button>
                  <button class="submit-btn" style="background:rgba(255,255,255,0.1);" onclick="document.getElementById('openMenuBtn').click()">Open Menu / Settings</button>
                </div>
              </div>
            `;
            renderFleetCards();
          }
        }
      }

      function updateHUD() {
        const onlineEdges = state.edges.filter(e => e.online);
        let totalSensors = 0;
        let totalFreeGb = 0;
        onlineEdges.forEach(e => {
          totalSensors += (e.sensors || []).length;
          if (e.collection && e.collection.disk_free_gb !== undefined) {
            totalFreeGb += parseFloat(e.collection.disk_free_gb) || 0;
          }
        });

        // Update Fleet Health Pill
        if (el.fleetHealthPill && el.fleetHealthText) {
          if (state.edges.length === 0) {
            el.fleetHealthPill.className = 'fleet-health-pill reconnecting';
            el.fleetHealthText.textContent = '📶 Discovering...';
          } else if (onlineEdges.length === 0) {
            el.fleetHealthPill.className = 'fleet-health-pill offline';
            el.fleetHealthText.textContent = '🔴 Fleet Offline';
          } else {
            const peerPings = onlineEdges.filter(e => !e.is_gateway && typeof e.ping_ms === 'number').map(e => e.ping_ms);
            const avgPing = peerPings.length > 0 
              ? Math.round(peerPings.reduce((a, b) => a + b, 0) / peerPings.length) 
              : 0;
            const pingLabel = avgPing > 0 ? `${avgPing}ms` : 'Mesh';
            el.fleetHealthPill.className = 'fleet-health-pill';
            el.fleetHealthText.textContent = `📶 ${onlineEdges.length}/${state.edges.length} Online (${pingLabel})`;
          }
        }

        if (el.menuEdgeBadge) el.menuEdgeBadge.textContent = onlineEdges.length;
        if (el.menuSensorsCount) el.menuSensorsCount.textContent = totalSensors;
        if (el.menuOnlineEdges) el.menuOnlineEdges.textContent = `${onlineEdges.length}/${state.edges.length}`;
        if (el.menuFreeStorage) el.menuFreeStorage.textContent = totalFreeGb > 0 ? `${totalFreeGb.toFixed(1)} GB` : '--';

        const isAnyRecording = onlineEdges.some(e => e.collection && e.collection.is_recording);
        state.isRecording = isAnyRecording;

        let maxDur = 0;
        if (isAnyRecording) {
          onlineEdges.forEach(e => {
            if (e.collection && e.collection.is_recording) {
              maxDur = Math.max(maxDur, e.collection.duration_seconds || 0);
            }
          });
          const durStr = formatDuration(maxDur);
          if (el.quickRecordBtn) el.quickRecordBtn.classList.add('recording');

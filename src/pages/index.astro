---
import '../styles/global.css';

const title = "CAPTURE.ME.UK v1.4 | Multi-Sensor Edge Collector";
const description = "Cloudflare-hosted mobile dashboard to monitor live streams and synchronize recording across multi-sensor edge devices.";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" content="#00e5ff">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="manifest" href="/manifest.webmanifest">
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
</head>
<body>
  <div class="app-container">
    <!-- Slim Modern Top Bar -->
    <header class="top-nav-slim">
      <div class="nav-left">
        <div class="brand-badge">
          <div class="pulse-dot"></div>
          <span class="brand-title">CAPTURE <small style="font-size:0.65rem;color:var(--accent-cyan);vertical-align:middle;font-weight:600;opacity:0.85;margin-left:2px;">v1.4</small></span>
        </div>

        <div class="nav-segmented">
          <button id="viewByModalityBtn" class="nav-seg-btn active" type="button" title="Group by Sensors">Sensors</button>
          <button id="viewByDeviceBtn" class="nav-seg-btn" type="button" title="Group by Device">Devices</button>
          <button id="viewPlaybackBtn" class="nav-seg-btn" type="button" title="View Recorded Frames & Scrubber">🎞️ Playback</button>
        </div>

        <div class="filter-pills" id="modalityPillsBar">
          <button class="pill active" data-mod="all" type="button">All</button>
          <button class="pill" data-mod="rgb" type="button">RGB</button>
          <button class="pill" data-mod="thermal" type="button">Thermal</button>
          <button class="pill" data-mod="depth" type="button">Depth</button>
          <button class="pill" data-mod="radar" type="button">Radar</button>
        </div>
      </div>

      <div class="nav-right">
        <!-- Snapshot / Request Latest Frame Pill -->
        <button id="btnSnapshotAll" class="nav-pill-btn" type="button" title="Request Latest Still Frame (Uses minimal 4G data)">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
            <circle cx="12" cy="13" r="4"></circle>
          </svg>
          <span id="snapshotBtnLabel">Snapshot</span>
        </button>

        <!-- Timed Live Video Toggle Pill -->
        <button id="quickDisplayBtn" class="nav-pill-btn" type="button" title="Start Timed Live Video Stream (4G Data Saver)">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
          <span id="quickDisplayLabel">Live (10s)</span>
        </button>

        <!-- Recording Pill -->
        <button id="quickRecordBtn" class="nav-pill-btn record-pill" type="button" title="Toggle Synchronized Edge Recording">
          <div class="record-dot"></div>
          <span id="quickRecordLabel">REC</span>
        </button>

        <!-- System & Tunnel Menu Button -->
        <button id="openMenuBtn" class="menu-btn" type="button" title="Open Settings & System Menu">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
          <span class="menu-btn-label">Menu</span>
          <span class="menu-badge" id="menuEdgeBadge">0</span>
        </button>
      </div>
    </header>

    <!-- Main Dynamic Feed Container (Centered 2 Columns) -->
    <main class="feeds-viewport" id="feedsViewport">
      <div class="loading-state">
        <div class="spinner"></div>
        <p>Connecting to Edge Devices via capture.me.uk...</p>
      </div>
    </main>

    <!-- Playback & Historical Frame Scrubbing Studio -->
    <section class="playback-viewport" id="playbackViewport" style="display: none;">
      <div class="playback-header-bar">
        <div class="playback-header-left">
          <span style="font-size:0.82rem; font-weight:700; color:var(--text-main); display:inline-flex; align-items:center; gap:6px;">
            <span>🎞️</span>
            <span>Session:</span>
          </span>
          <select id="playbackSessionSelect" class="playback-select" title="Select recorded session">
            <option value="">Loading sessions...</option>
          </select>
          <button id="refreshSessionsBtn" class="nav-seg-btn" type="button" style="padding: 4px 10px; font-size: 0.74rem;" title="Refresh Sessions">🔄 Refresh</button>
        </div>

        <div class="playback-header-right">
          <span class="playback-badge-chip" id="playbackSessionMetaBadge">-- frames &bull; --s</span>
          <select id="playbackDeviceFilter" class="playback-select" title="Filter device / modality view">
            <option value="all">Synchronized Fleet Grid (All Devices)</option>
          </select>
        </div>
      </div>

      <!-- Playback Grid of Cards -->
      <div class="playback-grid" id="playbackGrid">
        <div class="empty-state" style="grid-column: 1 / -1; padding: 36px 16px;">
          <p>Select a session to scrub and preview recorded frames.</p>
        </div>
      </div>

      <!-- Bottom Interactive Timeline Scrubber Dock -->
      <div class="playback-scrubber-dock" id="playbackScrubberDock">
        <div class="playback-slider-row">
          <div class="playback-slider-wrapper">
            <div class="playback-buffer-bar" id="playbackBufferBar" style="width: 0%;"></div>
            <input type="range" id="playbackSlider" class="timeline-slider" min="1" max="1" value="1" title="Drag to scrub through recorded frames">
          </div>
        </div>

        <div class="playback-controls-row">
          <div class="transport-btn-group">
            <button type="button" class="transport-btn" id="btnPlayFirst" title="First Frame (Home)">⏮</button>
            <button type="button" class="transport-btn" id="btnPlayPrev" title="Previous Frame (Left Arrow)">◀</button>
            <button type="button" class="transport-btn play-btn" id="btnPlayToggle" title="Play / Pause (Spacebar)">▶</button>
            <button type="button" class="transport-btn" id="btnPlayNext" title="Next Frame (Right Arrow)">▶</button>
            <button type="button" class="transport-btn" id="btnPlayLast" title="Last Frame (End)">⏭</button>
          </div>

          <div class="playback-hud-text" id="playbackHudContainer">
            <span><strong class="playback-hud-frame" id="playbackHudFrame">1 / 1</strong></span>
            <span style="color:var(--text-dim);">|</span>
            <span id="playbackHudTime">+00:00.0s / 00:00.0s</span>
          </div>

          <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
            <button type="button" class="btn-secondary-action active" id="btnSyncMode" title="Toggle between physical hardware timestamp synchronization and naive frame index">⏱️ Time Synced</button>
            <span class="buffer-chip" id="playbackBufferBadge" title="Frames cached in browser memory for instant smooth playback">RAM: 0%</span>
            <button type="button" class="btn-secondary-action" id="btnSyncHub" title="Download all session frames to PC Hub disk for offline access">💾 Cache to PC</button>
            <span style="font-size:0.75rem; color:var(--text-muted); margin-left:4px;">Speed:</span>
            <select id="playbackSpeedSelect" class="playback-speed-select">
              <option value="0.5">0.5x</option>
              <option value="1" selected>1.0x (10fps)</option>
              <option value="2">2.0x (20fps)</option>
            </select>
          </div>
        </div>
      </div>
    </section>
  <!-- 4G Cellular Data Saver & Timed Live Stream Pop-up Modal -->
  <div class="modal-backdrop" id="modalDataSaverBackdrop">
    <div class="modal-card" style="max-width: 460px;">
      <div class="modal-header">
        <div style="display:flex; align-items:center; gap:10px;">
          <span style="font-size:1.4rem;">📶</span>
          <div>
            <h3 style="margin:0; font-size:1.05rem; font-weight:700;">4G Cellular Data Saver</h3>
            <p style="margin:2px 0 0; font-size:0.75rem; color:var(--text-muted);">Prevent high mobile data transfer costs</p>
          </div>
        </div>
        <button type="button" class="modal-close-btn" id="closeDataSaverBtn" title="Close dialog">&times;</button>
      </div>

      <div class="modal-body" style="padding:18px 20px;">
        <div style="background:rgba(255, 171, 0, 0.12); border:1px solid rgba(255, 171, 0, 0.35); border-radius:8px; padding:12px; margin-bottom:16px;">
          <div style="display:flex; gap:10px; align-items:flex-start;">
            <span style="font-size:1.25rem;">⚠️</span>
            <div style="font-size:0.8rem; color:var(--text-main); line-height:1.45;">
              Continuous video streaming over 4G consumes <strong>5–15 MB per minute</strong> per camera.
              To avoid high carrier costs, live streaming is limited to a chosen preview window, after which it automatically returns to single-frame snapshot mode.
            </div>
          </div>
        </div>

        <label style="font-size:0.82rem; font-weight:600; margin-bottom:8px; display:block; color:var(--text-main);">Select Live Stream Duration:</label>
        <div class="duration-pills-row" style="display:flex; gap:8px; margin-bottom:16px; flex-wrap:wrap;">
          <button type="button" class="pill data-dur-btn" data-dur="5">5s (Quick Check)</button>
          <button type="button" class="pill active data-dur-btn" data-dur="10">10s (Default)</button>
          <button type="button" class="pill data-dur-btn" data-dur="20">20s</button>
          <button type="button" class="pill data-dur-btn" data-dur="30">30s</button>
          <button type="button" class="pill data-dur-btn" data-dur="60">60s (1m)</button>
        </div>

        <div style="display:flex; align-items:center; justify-content:flex-end; gap:10px; margin-top:22px;">
          <button type="button" class="btn-secondary-action" id="cancelDataSaverBtn" style="padding:8px 16px; font-size:0.85rem;">Cancel</button>
          <button type="button" class="submit-btn" id="confirmStartStreamBtn" style="padding:8px 18px; font-size:0.85rem; font-weight:700; background:linear-gradient(135deg, #00e5ff, #00b0ff); color:#000;">
            ▶️ Start 10s Live Stream
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Fleet Management & Hub Settings Modal -->
  <div class="modal-backdrop" id="modalBackdrop">
    <div class="modal-card wide-modal">
      <div class="modal-header">
        <div class="modal-header-tabs">
          <button type="button" class="modal-tab-btn active" id="tabOverviewBtn" data-tab="overview">
            <span>🌐</span>
            <span>Overview & Tunnel</span>
          </button>
          <button type="button" class="modal-tab-btn" id="tabFleetBtn" data-tab="fleet">
            <span>💻</span>
            <span>Fleet (<span id="modalFleetBadge">0/0</span>)</span>
          </button>
          <button type="button" class="modal-tab-btn" id="tabAddBtn" data-tab="add">
            <span>➕</span>
            <span>Add Device</span>
          </button>
          <button type="button" class="modal-tab-btn" id="tabConfigBtn" data-tab="config">
            <span>⚙️</span>
            <span>Hub Settings</span>
          </button>
        </div>
        <button class="close-btn" id="closeModalBtn" title="Close modal">&times;</button>
      </div>

      <div class="modal-body">
        <!-- TAB 1: OVERVIEW & TUNNEL -->
        <div class="modal-tab-pane active" id="tabPaneOverview">
          <!-- Cloudflare Tunnel Info Box -->
          <div class="tunnel-highlight-card">
            <div class="tunnel-card-header">
              <div class="tunnel-status-pill">
                <span class="pulse-dot-green"></span>
                <span>CLOUDFLARE TUNNEL</span>
              </div>
              <span class="tunnel-badge-active">ONLINE</span>
            </div>
            
            <div class="tunnel-url-row">
              <div class="tunnel-url-display" id="modalTunnelUrl">https://marvel-reconstruction-atm-planning.trycloudflare.com</div>
              <button type="button" class="copy-btn-tunnel" id="copyTunnelBtn" title="Copy Tunnel URL">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                <span id="copyBtnText">Copy</span>
              </button>
              <a href="https://marvel-reconstruction-atm-planning.trycloudflare.com" target="_blank" rel="noopener" class="open-link-btn" id="openTunnelLink" title="Open in new window">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
              </a>
            </div>

            <div class="tunnel-meta-row">
              <span><strong>Local LAN Hub:</strong> <code id="localIpLabel">http://192.168.137.1:8000</code></span>
              <span><strong>Custom Domain:</strong> <code>capture.me.uk</code></span>
            </div>
          </div>

          <!-- System Stats Grid -->
          <div class="menu-stats-grid">
            <div class="menu-stat-card">
              <span class="stat-num text-accent" id="menuSensorsCount">0</span>
              <span class="stat-sub">Active Sensors</span>
            </div>
            <div class="menu-stat-card">
              <span class="stat-num text-green" id="menuOnlineEdges">0/0</span>
              <span class="stat-sub">Edges Online</span>
            </div>
            <div class="menu-stat-card">
              <span class="stat-num" id="menuFreeStorage">--</span>
              <span class="stat-sub">SD Card Free</span>
            </div>
            <div class="menu-stat-card">
              <span class="stat-num" id="menuRecDuration">00:00:00</span>
              <span class="stat-sub" id="menuRecStatusLabel">Standby</span>
            </div>
          </div>

          <!-- Synchronized Recording Controls -->
          <div class="menu-rec-section">
            <div class="rec-section-header">
              <h4>🔴 Edge Synchronized Recording</h4>
              <span class="badge-tag" id="menuRecBadge">IDLE</span>
            </div>
            <p class="rec-section-desc">Starts synchronized local MJPEG / raw frame recording simultaneously across all connected edge nodes to internal SD card storage.</p>
            <div class="rec-controls-bar">
              <input type="text" id="recSessionLabelInput" placeholder="Session label" value="capture.me.uk Session" class="rec-label-input">
              <button type="button" id="modalCollectBtn" class="modal-action-btn record-action-btn">
                <div class="record-symbol"></div>
                <span id="modalCollectBtnText">Start Recording</span>
              </button>
            </div>
            <div class="storage-path-box">
              <span class="path-title">Internal Edge File Pattern:</span>
              <code>&lt;device&gt;/&lt;YYYY-MM-DD&gt;/&lt;HH-MM-SS&gt;/&lt;modality&gt;/frame_*.jpg</code>
            </div>
          </div>
        </div>

        <!-- TAB 2: FLEET AVAILABILITY -->
        <div class="modal-tab-pane" id="tabPaneFleet">
          <div class="fleet-header-summary">
            <div class="fleet-stats">
              <span class="stat-pill"><strong id="summaryTotalEdges">0</strong> Total Devices</span>
              <span class="stat-pill online-pill"><strong id="summaryOnlineEdges">0</strong> Available Online</span>
            </div>
            <button type="button" class="pill-btn-refresh" id="refreshFleetBtn" title="Ping & Test all devices">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
              </svg>
              <span>Ping / Refresh</span>
            </button>
          </div>

          <div class="fleet-cards-list" id="fleetCardsContainer">
            <!-- Dynamically populated -->
          </div>
        </div>

        <!-- TAB 2: ADD NEW DEVICE -->
        <div class="modal-tab-pane" id="tabPaneAdd">
          <div class="phone-connect-box">
            <h4>➕ Register New Edge Device</h4>
            <p>Connect another Raspberry Pi Zero, 4/5, or Linux camera rig to the centralized aggregator:</p>
          </div>
          <form id="addEdgeForm" class="add-edge-form">
            <div class="form-row">
              <div class="form-group flex-2">
                <label>Device Name / Label</label>
                <input type="text" id="edgeNameInput" placeholder="Raspberry Pi Zero (STEVAL-55G0MBI)" required>
              </div>
              <div class="form-group flex-1">
                <label>Device ID</label>
                <input type="text" id="edgeIdInput" placeholder="edge-pi-zero-02" required>
              </div>
            </div>
            <div class="form-row">
              <div class="form-group flex-2">
                <label>IP Address / Hostname / Tailscale</label>
                <input type="text" id="edgeHostInput" placeholder="192.168.137.240" required>
              </div>
              <div class="form-group flex-1">
                <label>Port</label>
                <input type="number" id="edgePortInput" value="5001" required>
              </div>
            </div>
            <button type="submit" class="submit-btn">+ Add Edge Device</button>
          </form>
        </div>

        <!-- TAB 3: HUB & TUNNEL CONFIG -->
        <div class="modal-tab-pane" id="tabPaneConfig">
          <div class="phone-connect-box">
            <h4>🌐 Edge Hub & Cloudflare Tunnel Endpoint</h4>
            <p>Specify the proxy hub or Cloudflare Tunnel that bridges browser visitors to your edge fleet:</p>
            <div style="display:flex; gap:8px; margin-bottom:8px;">
              <input type="text" id="hubUrlInput" style="flex:1; background:rgba(0,0,0,0.4); border:1px solid var(--border-color); color:#fff; padding:8px; border-radius:6px; font-family:var(--font-mono); font-size:0.85rem;" placeholder="https://marvel-reconstruction-atm-planning.trycloudflare.com">
              <button type="button" class="copy-btn" id="saveHubUrlBtn">Save</button>
            </div>
            <div style="display:flex; gap:6px; flex-wrap:wrap; margin-bottom:10px;">
              <button type="button" class="pill active" id="btnPresetDefault" style="font-size:0.75rem; padding:4px 8px; cursor:pointer;">☁️ Reset to Server Default (config.json)</button>
              <button type="button" class="pill" id="btnPresetLocal" style="font-size:0.75rem; padding:4px 8px; cursor:pointer;" onclick="window.setQuickHub('http://127.0.0.1:8000')">💻 Local PC Hub (8000)</button>
              <button type="button" class="pill" id="btnPresetDirectPi" style="font-size:0.75rem; padding:4px 8px; cursor:pointer;" onclick="window.setQuickHub('http://192.168.137.240:5001')">🍓 Direct Pi (5001)</button>
            </div>
            <small style="color:var(--text-muted); font-size:0.75rem;">Visitors to <code>capture.me.uk</code> automatically load the default endpoint from <code>/config.json</code>.</small>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Client-Side Dashboard Script -->
  <script is:inline>
    (function () {
      'use strict';

      let clientConfig = null;
      let hubBaseUrl = '';

      const FLEET_NODE_DEFAULTS = [
        { id: "edge-pi-zero-01", name: "Pi Zero #2", url: "https://fleet.capture.me.uk" },
        { id: "edge-pi-zero-03", name: "Pi Zero #1", url: "https://fleet1.capture.me.uk" },
        { id: "edge-pi-zero-02", name: "Pi Zero #3", url: "https://fleet3.capture.me.uk" }
      ];

      function getStreamUrl(edge, target) {
        if (edge && edge.tunnel_url) {
          return `${edge.tunnel_url}/api/stream/${target}`;
        }
        const devId = edge ? edge.device_id : '';
        return `${hubBaseUrl}/proxy/stream/${devId}/${target}`;
      }

      function getSnapshotUrl(edge, target, ts) {
        const tParam = ts ? `?t=${ts}` : '';
        if (edge && edge.tunnel_url) {
          return `${edge.tunnel_url}/api/snapshot/${target}${tParam}`;
        }
        const devId = edge ? edge.device_id : '';
        return `${hubBaseUrl}/proxy/snapshot/${devId}/${target}${tParam}`;
      }

      async function loadClientConfig() {
        try {
          const res = await fetch('/config.json?v=' + Date.now());
          if (res.ok) {
            clientConfig = await res.json();
          }
        } catch (e) {
          console.warn('Could not load /config.json:', e);
        }

        let defaultHub;
        if (window.location.port === '8000' || window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1' || window.location.hostname.startsWith('192.168.')) {
          defaultHub = window.location.origin;
        } else {
          defaultHub = clientConfig?.default_hub_url || 'https://fleet.capture.me.uk';
        }

        let savedHub = localStorage.getItem('capture_hub_url');
        if (savedHub && (savedHub.includes('192.168.41.78') || savedHub.includes('192.168.1.100') || savedHub.includes('192.168.1.150') || savedHub.includes('lynn-oak'))) {
          savedHub = null;
          localStorage.removeItem('capture_hub_url');
        }

        hubBaseUrl = savedHub || defaultHub;
      }

      const state = {
        viewMode: 'modality',
        selectedModalityFilter: 'all',
        displayEnabled: true,
        isRecording: false,
        edges: [],
        pollTimer: null,

        // Playback & Frame Scrubbing State
        playbackSessions: [],
        currentSession: null,
        currentFrameIdx: 1,
        maxFrames: 1,
        isPlaying: false,
        playbackTimer: null,
        playbackSpeed: 1.0,
        selectedPlaybackFilter: 'all',

        // Hardware Timestamp Synchronization State
        timeSyncEnabled: true,
        streamMetadata: {},
        commonStartTs: 0.0,
        commonEndTs: 0.0,
        commonDuration: 0.0,
        currentTimeSec: 0.0,

        // 4G Data Saver & Timed Streaming State

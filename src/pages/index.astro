          elBox.classList.remove('fullscreen-active');
        });
        if (willBeFull) {
          box.classList.add('fullscreen-active');
          state.fullscreenSensorKey = `${deviceId}:${sensorId}`;
          const fKey = `${deviceId}:${target}`;
          const isSensorLive = state.liveStreamingActive || Boolean(state.sensorLiveTimers && state.sensorLiveTimers[fKey]);
          if (!isSensorLive) {
            window.requestSensorSnapshot(deviceId, target);
          }
        } else {
          state.fullscreenSensorKey = null;
        }

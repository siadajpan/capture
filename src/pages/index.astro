      // ==============================================================================
      // Playback Studio & Frame Scrubbing Engine
      // ==============================================================================

      async function loadPlaybackSessions(autoSelectFirst = true) {
        try {
          const res = await fetch(`${hubBaseUrl}/api/recordings/sessions`);
          if (!res.ok) throw new Error('Status ' + res.status);
          const data = await res.json();
          state.playbackSessions = data.sessions || [];

          if (!el.playbackSessionSelect) return;

          if (state.playbackSessions.length === 0) {
            el.playbackSessionSelect.innerHTML = '<option value="">No recorded sessions found</option>';
            if (el.playbackGrid) {
              el.playbackGrid.innerHTML = `
                <div class="empty-state" style="grid-column: 1 / -1; padding: 40px 16px;">
                  <p>No recorded sessions found on connected edge devices.</p>
                  <p style="font-size:0.75rem; color:var(--text-muted); margin-top:8px;">Start a recording from the REC button to create your first session.</p>
                </div>
              `;
            }
            if (el.playbackSessionMetaBadge) el.playbackSessionMetaBadge.textContent = '0 frames • 0s';
            return;
          }

          let html = '';
          state.playbackSessions.forEach(s => {
            const timeFormatted = (s.time || '').replace(/-/g, ':');
            const dur = s.duration_seconds ? `${s.duration_seconds.toFixed(1)}s` : '--';
            const devCount = (s.devices || []).length;
            html += `<option value="${escapeHtml(s.id)}">${escapeHtml(s.date)} ${escapeHtml(timeFormatted)} • ${escapeHtml(s.label || 'Session')} • ${s.max_frames} frames (${dur}, ${devCount} devs)</option>`;
          });
          el.playbackSessionSelect.innerHTML = html;

          if (autoSelectFirst || !state.currentSession) {
            selectPlaybackSession(state.playbackSessions[0].id);
          } else {
            const exists = state.playbackSessions.some(s => s.id === state.currentSession.id);
            if (exists) {
              el.playbackSessionSelect.value = state.currentSession.id;
            } else {
              selectPlaybackSession(state.playbackSessions[0].id);
            }
          }
        } catch (err) {
          console.error('Error loading playback sessions:', err);
          if (el.playbackSessionSelect) {
            el.playbackSessionSelect.innerHTML = '<option value="">Failed to fetch sessions from Hub</option>';
          }
        }
      }

      // ==============================================================================
      // Playback Studio & Frame Scrubbing Engine (In-Memory Buffer + Frame-Paced Playback)
      // ==============================================================================

      const frameCache = new Map(); // key: `${deviceId}:${modality}:${devIdx}` -> blob URL
      let prebufferAbort = false;
      let prebufferRunning = false;
      let playbackAnimFrameId = null;
      let lastFrameTime = 0;
      let scrubRafId = null;
      let syncPollingInterval = null;

      async function getOrFetchFrame(devId, date, time, mod, devIdx) {
        const key = `${devId}:${mod}:${devIdx}`;
        if (frameCache.has(key)) {
          return frameCache.get(key);
        }
        const url = `${hubBaseUrl}/proxy/recording/${devId}/${date}/${time}/${mod}/${devIdx}`;
        try {
          const res = await fetch(url);
          if (res.ok) {
            const blob = await res.blob();
            const blobUrl = URL.createObjectURL(blob);
            frameCache.set(key, blobUrl);
            updateBufferStats();
            return blobUrl;
          }
        } catch (e) {
          // fetch error fallback
        }
        return url;
      }

      function updateBufferStats() {
        if (!state.currentSession) return;
        const session = state.currentSession;
        let totalNeeded = 0;
        let totalCached = 0;

        (session.devices || []).forEach(dev => {
          (dev.modalities || []).forEach(mod => {
            const fcount = mod.frames_count || state.maxFrames;
            totalNeeded += fcount;
            for (let i = 1; i <= fcount; i++) {
              if (frameCache.has(`${dev.device_id}:${mod.id}:${i}`)) {
                totalCached++;
              }
            }
          });
        });

        const pct = totalNeeded > 0 ? Math.min(100, Math.round((totalCached / totalNeeded) * 100)) : 0;
        if (el.playbackBufferBar) {
          el.playbackBufferBar.style.width = `${pct}%`;
        }
        if (el.playbackBufferBadge) {
          if (pct >= 100) {
            el.playbackBufferBadge.textContent = `RAM: 100% (${totalCached}f Ready)`;
            el.playbackBufferBadge.classList.add('cached');
          } else {
            el.playbackBufferBadge.textContent = `RAM: ${pct}% (${totalCached}/${totalNeeded})`;
            el.playbackBufferBadge.classList.remove('cached');
          }
        }
      }

      async function startPrebuffering() {
        if (!state.currentSession) return;
        prebufferAbort = false;
        if (prebufferRunning) return;
        prebufferRunning = true;

        const session = state.currentSession;
        const streams = [];
        (session.devices || []).forEach(dev => {
          (dev.modalities || []).forEach(mod => {
            streams.push({ dev, mod });
          });
        });

        const maxFrames = state.maxFrames;
        const frameIndices = [];
        for (let i = state.currentFrameIdx; i <= maxFrames; i++) frameIndices.push(i);
        for (let i = 1; i < state.currentFrameIdx; i++) frameIndices.push(i);

        let queueIdx = 0;
        const concurrency = 4;

        async function prebufferWorker() {
          while (queueIdx < frameIndices.length && !prebufferAbort) {
            const fNum = frameIndices[queueIdx++];
            for (const { dev, mod } of streams) {
              if (prebufferAbort) break;
              const cardMax = mod.frames_count || maxFrames;
              const devIdx = Math.max(1, Math.min(fNum, cardMax));
              const key = `${dev.device_id}:${mod.id}:${devIdx}`;
              if (!frameCache.has(key)) {
                await getOrFetchFrame(dev.device_id, dev.date, dev.time, mod.id, devIdx);
              }
            }
          }
        }

        const workers = Array.from({ length: concurrency }, () => prebufferWorker());
        await Promise.all(workers);
        prebufferRunning = false;
        updateBufferStats();
      }

      async function triggerSyncHub() {
        if (!state.currentSession) return;
        const sessionId = state.currentSession.id;
        if (!el.btnSyncHub) return;

        el.btnSyncHub.textContent = '⏳ Starting Cache...';
        try {
          const res = await fetch(`${hubBaseUrl}/api/recordings/${sessionId}/cache-all`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({})
          });
          if (res.ok) {
            if (syncPollingInterval) clearInterval(syncPollingInterval);
            syncPollingInterval = setInterval(async () => {
              try {
                const sres = await fetch(`${hubBaseUrl}/api/recordings/${sessionId}/cache-status`);
                if (sres.ok) {
                  const sdata = await sres.json();
                  if (sdata.done) {
                    clearInterval(syncPollingInterval);
                    syncPollingInterval = null;
                    el.btnSyncHub.textContent = '✅ Cached on PC';
                    el.btnSyncHub.style.borderColor = 'var(--accent-cyan)';
                    startPrebuffering();
                  } else if (sdata.in_progress) {
                    el.btnSyncHub.textContent = `💾 PC: ${sdata.percent}% (${sdata.cached}/${sdata.total})`;
                  }
                }
              } catch (e) {}
            }, 750);
          }
        } catch (err) {
          el.btnSyncHub.textContent = '❌ Sync Failed';
          setTimeout(() => { if (el.btnSyncHub) el.btnSyncHub.textContent = '💾 Cache to PC'; }, 2000);
        }
      }

      async function checkHubCacheStatus(sessionId) {
        if (!el.btnSyncHub) return;
        try {
          const res = await fetch(`${hubBaseUrl}/api/recordings/${sessionId}/cache-status`);
          if (res.ok) {

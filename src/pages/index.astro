        if (el.copyTunnelBtn) {
          el.copyTunnelBtn.addEventListener('click', () => {
            const url = el.modalTunnelUrl ? el.modalTunnelUrl.textContent.trim() : hubBaseUrl;
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(url).then(() => {
                if (el.copyBtnText) el.copyBtnText.textContent = 'Copied!';
                setTimeout(() => { if (el.copyBtnText) el.copyBtnText.textContent = 'Copy'; }, 2000);
              }).catch(() => fallbackCopy(url));

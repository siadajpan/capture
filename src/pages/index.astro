      async function fetchSystemInfo() {
        try {
          const controller = new AbortController();
          const tId = setTimeout(() => controller.abort(), 1500);
          const res = await fetch(`${hubBaseUrl}/api/info`, { signal: controller.signal });
          clearTimeout(tId);
          if (res.ok) {
            const info = await res.json();
            const tunnel = info.tunnel_url || clientConfig?.default_hub_url || hubBaseUrl;
            if (el.modalTunnelUrl) el.modalTunnelUrl.textContent = tunnel;
            if (el.openTunnelLink) el.openTunnelLink.href = tunnel;
            if (el.localIpLabel && info.mobile_url) el.localIpLabel.textContent = info.mobile_url;
          }
        } catch (e) {
          const fallbackTunnel = clientConfig?.default_hub_url || 'https://fleet.capture.me.uk';
          if (el.modalTunnelUrl) el.modalTunnelUrl.textContent = fallbackTunnel;
          if (el.openTunnelLink) el.openTunnelLink.href = fallbackTunnel;
        }
      }

      window.switchModalTab = function (tabName) {
        document.querySelectorAll('.modal-tab-btn').forEach(btn => {
          btn.classList.toggle('active', btn.dataset.tab === tabName);
        });
        document.querySelectorAll('.modal-tab-pane').forEach(pane => {
          pane.classList.remove('active');
        });
        const target = document.getElementById('tabPane' + tabName.charAt(0).toUpperCase() + tabName.slice(1));
        if (target) target.classList.add('active');
      };


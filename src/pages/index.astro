              el.btnSyncHub.style.borderColor = '';
            }
          }
        } catch (e) {}
      }

      function findClosestFrameIndex(timestamps, targetTs) {
        if (!timestamps || timestamps.length === 0) return { frameIdx: 1, deltaMs: 0 };
        const len = timestamps.length;
        if (targetTs <= timestamps[0]) {
          return { frameIdx: 1, deltaMs: Math.round((timestamps[0] - targetTs) * 1000) };
        }
        if (targetTs >= timestamps[len - 1]) {
          return { frameIdx: len, deltaMs: Math.round((timestamps[len - 1] - targetTs) * 1000) };
        }

        let low = 0;
        let high = len - 1;
        while (low <= high) {
          const mid = (low + high) >> 1;
          const midVal = timestamps[mid];
          if (midVal === targetTs) {
            return { frameIdx: mid + 1, deltaMs: 0 };
          } else if (midVal < targetTs) {
            low = mid + 1;
          } else {
            high = mid - 1;
          }
        }

        const idx1 = Math.max(0, Math.min(high, len - 1));
        const idx2 = Math.max(0, Math.min(low, len - 1));
        const diff1 = Math.abs(timestamps[idx1] - targetTs);
        const diff2 = Math.abs(timestamps[idx2] - targetTs);
        const bestIdx = diff1 <= diff2 ? idx1 : idx2;
        const deltaMs = Math.round((timestamps[bestIdx] - targetTs) * 1000);
        return { frameIdx: bestIdx + 1, deltaMs };
      }

      function getFrameForStream(devId, modId, maxCount) {
        const fKey = `${devId}:${modId}`;
        const meta = state.streamMetadata[fKey];
        if (state.timeSyncEnabled && meta && meta.timestamps && meta.timestamps.length > 0) {
          const targetTs = state.commonStartTs + state.currentTimeSec;
          return findClosestFrameIndex(meta.timestamps, targetTs);
        } else if (state.timeSyncEnabled && state.commonDuration > 0) {
          const pct = Math.max(0, Math.min(1, state.currentTimeSec / state.commonDuration));
          const frameIdx = Math.max(1, Math.min(Math.round(pct * (maxCount - 1)) + 1, maxCount));
          return { frameIdx, deltaMs: 0 };
        } else {
          const frameIdx = Math.max(1, Math.min(state.currentFrameIdx, maxCount));
          return { frameIdx, deltaMs: 0 };
        }
      }

      function calculateTemporalOverlap() {
        const metas = Object.values(state.streamMetadata).filter(m => m && m.timestamps && m.timestamps.length > 0);
        if (metas.length === 0) {
          state.commonStartTs = 0;
          state.commonEndTs = 0;
          state.commonDuration = (state.currentSession?.duration_seconds || (state.maxFrames / 10.0));
          return;
        }

        const starts = metas.map(m => m.start_ts || m.timestamps[0]);
        const ends = metas.map(m => m.end_ts || m.timestamps[m.timestamps.length - 1]);

        const commonStart = Math.max(...starts);
        const commonEnd = Math.min(...ends);

        if (commonEnd > commonStart + 0.1) {
          state.commonStartTs = commonStart;
          state.commonEndTs = commonEnd;
          state.commonDuration = commonEnd - commonStart;
        } else {
          // If overlap is tiny or non-overlapping, fall back to union range
          state.commonStartTs = Math.min(...starts);
          state.commonEndTs = Math.max(...ends);
          state.commonDuration = Math.max(1, state.commonEndTs - state.commonStartTs);
        }
      }

      function configureScrubberSlider() {
        if (!el.playbackSlider) return;
        if (state.timeSyncEnabled && state.commonDuration > 0) {
          el.playbackSlider.min = '0';
          el.playbackSlider.max = state.commonDuration.toFixed(2);
          el.playbackSlider.step = '0.05';
          el.playbackSlider.value = state.currentTimeSec.toFixed(2);
        } else {
          el.playbackSlider.min = '1';
          el.playbackSlider.max = String(state.maxFrames);
          el.playbackSlider.step = '1';
          el.playbackSlider.value = String(state.currentFrameIdx);
        }
      }

      async function loadSessionStreamMetadata(session) {
        state.streamMetadata = {};
        const promises = [];
        (session.devices || []).forEach(dev => {
          (dev.modalities || []).forEach(mod => {
            const streamKey = `${dev.device_id}:${mod.id}`;
            const url = `${hubBaseUrl}/api/recordings/${dev.device_id}/${dev.date}/${dev.time}/${mod.id}/frames`;
            promises.push(
              fetch(url)
                .then(res => res.ok ? res.json() : null)
                .then(data => {
                  if (data && data.timestamps && data.timestamps.length > 0) {
                    state.streamMetadata[streamKey] = data;
                  }
                })
                .catch(e => console.warn(`Failed fetching timestamps for ${streamKey}:`, e))
            );
          });
        });
        await Promise.allSettled(promises);
        calculateTemporalOverlap();
        configureScrubberSlider();

        // Update meta badge with overlap duration
        if (el.playbackSessionMetaBadge && state.commonDuration > 0) {
          const devCount = (session.devices || []).length;
          el.playbackSessionMetaBadge.textContent = `${state.maxFrames} frames • ${state.commonDuration.toFixed(1)}s overlap • ${devCount} devices`;
        }
        updatePlaybackView();
      }

      async function selectPlaybackSession(sessionId) {
        const session = state.playbackSessions.find(s => s.id === sessionId);
        if (!session) return;

        prebufferAbort = true;
        frameCache.clear();
        updateBufferStats();

        state.currentSession = session;
        state.maxFrames = Math.max(1, session.max_frames || 1);
        state.currentFrameIdx = 1;
        state.currentTimeSec = 0.0;
        state.streamMetadata = {};

        if (el.playbackSessionSelect) el.playbackSessionSelect.value = sessionId;

        // Populate device filter
        if (el.playbackDeviceFilter) {
          let filterHtml = '<option value="all">Synchronized Fleet Grid (All Devices & Streams)</option>';
          (session.devices || []).forEach(dev => {
            (dev.modalities || []).forEach(mod => {
              const fKey = `${dev.device_id}:${mod.id}`;
              filterHtml += `<option value="${escapeHtml(fKey)}">${escapeHtml(dev.device_name || dev.device_id)} • ${escapeHtml(mod.name || mod.id)} (${mod.frames_count || 0} frames)</option>`;
            });
          });
          el.playbackDeviceFilter.innerHTML = filterHtml;
          state.selectedPlaybackFilter = 'all';
        }

        // Update meta badge
        if (el.playbackSessionMetaBadge) {
          const dur = session.duration_seconds ? `${session.duration_seconds.toFixed(1)}s` : '--';
          const devCount = (session.devices || []).length;
          el.playbackSessionMetaBadge.textContent = `${state.maxFrames} frames • ${dur} • ${devCount} devices`;
        }

        // Setup scrubber slider
        configureScrubberSlider();

        stopPlayback();
        renderPlaybackGrid();
        updatePlaybackHUD();
        checkHubCacheStatus(sessionId);

        // Fetch stream timestamps for synchronized playback
        await loadSessionStreamMetadata(session);

        startPrebuffering();
      }

      function renderPlaybackGrid() {
        if (!el.playbackGrid || !state.currentSession) return;

        const session = state.currentSession;
        const streams = [];

        (session.devices || []).forEach(dev => {
          (dev.modalities || []).forEach(mod => {
            const fKey = `${dev.device_id}:${mod.id}`;
            if (state.selectedPlaybackFilter !== 'all' && state.selectedPlaybackFilter !== fKey) {
              return;
            }
            streams.push({ dev, mod });
          });
        });

        if (streams.length === 0) {
          el.playbackGrid.innerHTML = `
            <div class="empty-state" style="grid-column: 1 / -1; padding: 36px 16px;">
              <p>No streams match the selected filter.</p>
            </div>
          `;
          return;
        }

        let html = '';
        streams.forEach(({ dev, mod }) => {
          const modType = (mod.modality || 'rgb').toLowerCase();
          const maxCount = mod.frames_count || state.maxFrames;
          const { frameIdx: initialFrame, deltaMs: initialDelta } = getFrameForStream(dev.device_id, mod.id, maxCount);
          const key = `${dev.device_id}:${mod.id}:${initialFrame}`;
          const initialUrl = frameCache.get(key) || `${hubBaseUrl}/proxy/recording/${dev.device_id}/${dev.date}/${dev.time}/${mod.id}/${initialFrame}`;

          let badgeContent = `Frame ${initialFrame} / ${maxCount}`;
          if (state.timeSyncEnabled) {
            const deltaFormatted = (initialDelta >= 0 ? '+' : '') + initialDelta + 'ms';
            const color = Math.abs(initialDelta) <= 60 ? 'var(--accent-cyan)' : 'var(--accent-amber)';
            badgeContent += ` <span style="color:${color}; font-size:0.7rem; font-weight:600; margin-left:4px;">(Δ${deltaFormatted})</span>`;
          }

          html += `
            <div class="playback-card"
                 data-device-id="${escapeHtml(dev.device_id)}"
                 data-date="${escapeHtml(dev.date)}"
                 data-time="${escapeHtml(dev.time)}"
                 data-modality="${escapeHtml(mod.id)}"
                 data-max-frames="${maxCount}">
              <div class="playback-card-header">
                <div class="playback-card-title">
                  <span class="status-indicator"></span>
                  <span style="font-weight:700;">${escapeHtml(dev.device_name || dev.device_id)}</span>
                  <span class="device-id-tag">${escapeHtml(dev.device_id)}</span>
                </div>
                <span class="playback-card-modality ${modType}">${escapeHtml(mod.modality || modType).toUpperCase()}</span>
              </div>
              
              <div class="playback-card-body">
                <img src="${initialUrl}" alt="${escapeHtml(mod.name || mod.id)}" class="playback-frame-img" loading="eager" />
              </div>

              <div class="playback-card-footer">
                <span style="color:var(--text-main); font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;" title="${escapeHtml(mod.name || mod.id)}">${escapeHtml(mod.name || mod.id)}</span>
                <span class="card-frame-badge">${badgeContent}</span>
              </div>
            </div>
          `;
        });

        el.playbackGrid.innerHTML = html;
      }

      function setPlaybackFrame(idx) {
        if (!state.currentSession) return;
        idx = Math.max(1, Math.min(idx, state.maxFrames));
        state.currentFrameIdx = idx;

        if (state.commonDuration > 0) {
          const pct = (state.currentFrameIdx - 1) / Math.max(1, state.maxFrames - 1);
          state.currentTimeSec = pct * state.commonDuration;
        }

        updatePlaybackView();
      }

      function seekToTime(timeSec) {
        if (!state.currentSession) return;
        state.currentTimeSec = Math.max(0, Math.min(timeSec, state.commonDuration));

        if (state.commonDuration > 0) {
          const pct = state.currentTimeSec / state.commonDuration;
          state.currentFrameIdx = Math.max(1, Math.min(Math.round(pct * (state.maxFrames - 1)) + 1, state.maxFrames));
        }

        updatePlaybackView();
      }

      function updatePlaybackView() {
        if (!state.currentSession) return;

        if (el.playbackSlider) {
          if (state.timeSyncEnabled) {
            el.playbackSlider.value = state.currentTimeSec.toFixed(2);
          } else {
            el.playbackSlider.value = String(state.currentFrameIdx);
          }
        }

        updatePlaybackHUD();

        const cards = document.querySelectorAll('.playback-card');
        cards.forEach(card => {
          const devId = card.dataset.deviceId;
          const date = card.dataset.date;
          const time = card.dataset.time;
          const mod = card.dataset.modality;
          const cardMax = parseInt(card.dataset.maxFrames, 10) || state.maxFrames;

          const { frameIdx: devIdx, deltaMs } = getFrameForStream(devId, mod, cardMax);
          const key = `${devId}:${mod}:${devIdx}`;

          const img = card.querySelector('.playback-frame-img');
          if (img) {
            if (frameCache.has(key)) {
              img.src = frameCache.get(key);
            } else {
              const directUrl = `${hubBaseUrl}/proxy/recording/${devId}/${date}/${time}/${mod}/${devIdx}`;
              img.src = directUrl;
              getOrFetchFrame(devId, date, time, mod, devIdx);
            }
          }

          const badge = card.querySelector('.card-frame-badge');
          if (badge) {
            if (state.timeSyncEnabled) {
              const deltaFormatted = (deltaMs >= 0 ? '+' : '') + deltaMs + 'ms';
              const color = Math.abs(deltaMs) <= 60 ? 'var(--accent-cyan)' : 'var(--accent-amber)';
              badge.innerHTML = `Frame ${devIdx} / ${cardMax} <span style="color:${color}; font-size:0.7rem; font-weight:600; margin-left:4px;">(Δ${deltaFormatted})</span>`;
            } else {
              badge.textContent = `Frame ${devIdx} / ${cardMax}`;
            }
          }
        });
      }

      function updatePlaybackHUD() {
        if (!state.currentSession) return;

        if (state.timeSyncEnabled) {
          if (el.playbackHudFrame) {
            el.playbackHudFrame.innerHTML = `⏱️ ${formatTimeSec(state.currentTimeSec)} / ${formatTimeSec(state.commonDuration)}`;
          }
          if (el.playbackHudTime) {
            const pct = state.commonDuration > 0 ? Math.round((state.currentTimeSec / state.commonDuration) * 100) : 0;
            el.playbackHudTime.innerHTML = `<span style="color:var(--accent-cyan); font-weight:600;">SYNCED</span> (${pct}%)`;
          }
        } else {
          if (el.playbackHudFrame) {
            el.playbackHudFrame.textContent = `${state.currentFrameIdx} / ${state.maxFrames}`;
          }
          if (el.playbackHudTime) {
            const currentSec = (state.currentFrameIdx - 1) / 10.0;
            const totalSec = state.currentSession?.duration_seconds || (state.maxFrames / 10.0);
            el.playbackHudTime.textContent = `+${formatTimeSec(currentSec)} / ${formatTimeSec(totalSec)}`;
          }
        }
      }

      function formatTimeSec(seconds) {
        const s = Math.max(0, seconds);
        const mins = Math.floor(s / 60).toString().padStart(2, '0');
        const secs = (s % 60).toFixed(1).padStart(4, '0');
        return `${mins}:${secs}s`;
      }

      function togglePlayback() {
        if (state.isPlaying) {
          stopPlayback();
        } else {
          if (state.timeSyncEnabled) {
            if (state.currentTimeSec >= state.commonDuration - 0.05) {
              seekToTime(0);
            }
          } else {
            if (state.currentFrameIdx >= state.maxFrames) {
              setPlaybackFrame(1);
            }
          }
          startPlayback();
        }
      }

      function playbackLoop(timestamp) {
        if (!state.isPlaying) return;

        if (!lastFrameTime) lastFrameTime = timestamp;
        const elapsed = timestamp - lastFrameTime;

        if (state.timeSyncEnabled) {
          if (elapsed >= 33) {
            const elapsedSec = elapsed / 1000.0;
            lastFrameTime = timestamp;
            state.currentTimeSec += elapsedSec * state.playbackSpeed;
            if (state.currentTimeSec >= state.commonDuration) {
              state.currentTimeSec = 0; // loop
            }
            if (state.commonDuration > 0) {
              const pct = state.currentTimeSec / state.commonDuration;
              state.currentFrameIdx = Math.max(1, Math.min(Math.round(pct * (state.maxFrames - 1)) + 1, state.maxFrames));
            }
            updatePlaybackView();
          }
        } else {
          const baseFps = 10;
          const targetFps = baseFps * state.playbackSpeed;
          const frameIntervalMs = 1000 / targetFps;

          if (elapsed >= frameIntervalMs) {
            lastFrameTime = timestamp - (elapsed % frameIntervalMs);
            const nextIdx = (state.currentFrameIdx >= state.maxFrames) ? 1 : state.currentFrameIdx + 1;
            setPlaybackFrame(nextIdx);
          }
        }

        if (state.isPlaying) {
          playbackAnimFrameId = requestAnimationFrame(playbackLoop);
        }
      }

      function startPlayback() {
        stopPlayback();
        state.isPlaying = true;
        if (el.btnPlayToggle) {
          el.btnPlayToggle.textContent = '⏸';
          el.btnPlayToggle.classList.add('playing');
        }
        lastFrameTime = 0;
        playbackAnimFrameId = requestAnimationFrame(playbackLoop);
      }

      function stopPlayback() {
        state.isPlaying = false;
        if (el.btnPlayToggle) {
          el.btnPlayToggle.textContent = '▶';
          el.btnPlayToggle.classList.remove('playing');
        }
        if (playbackAnimFrameId) {
          cancelAnimationFrame(playbackAnimFrameId);
          playbackAnimFrameId = null;
        }
      }

      function renderFeeds() {
        if (state.edges.length === 0) {
          el.feedsViewport.innerHTML = `
            <div class="empty-state">
              <p>No edge devices configured.</p>
              <button class="submit-btn" onclick="window.switchModalTab('add'); el.modalBackdrop.classList.add('open');">+ Add Edge Device</button>
            </div>
          `;
          state.lastFeedsStructureKey = '';
          return;
        }

        const structureKey = state.edges.map(e => `${e.device_id}:${e.online}:${(e.sensors || []).map(s => s.id).join(',')}`).join('|') + `|${state.viewMode}|${state.selectedModalityFilter}`;

        if (state.lastFeedsStructureKey === structureKey) {
          updateFeedTelemetryInPlace();
          return;
        }

        state.lastFeedsStructureKey = structureKey;
        if (state.viewMode === 'device') {
          renderByDevice();
        } else {
          renderByModality();
        }
      }

      function updateFeedTelemetryInPlace() {
        state.edges.forEach(edge => {
          const col = edge.collection || {};
          const isRec = col.is_recording;
          const card = document.getElementById(`card-${edge.device_id}`);
          if (card) {
            const ind = card.querySelector('.status-indicator');
            if (ind) ind.className = `status-indicator ${edge.online ? '' : 'offline'}`;
            const telem = card.querySelector('.device-telemetry');
            if (telem) {
              const freeGb = col.disk_free_gb !== undefined ? `${col.disk_free_gb} GB` : 'Ready';
              telem.innerHTML = `
                ${isRec ? `<span class="rec-pulse-chip">⏺ ${col.duration_seconds || 0}s</span>` : ''}
                <span class="storage-badge" title="SD Free: ${freeGb}">💾 ${freeGb}</span>
              `;
            }
          }
          (edge.sensors || []).forEach(sensor => {
            const feedBox = document.getElementById(`sensor-${edge.device_id}-${sensor.id}`);
            if (feedBox) {
              const footerSpan = feedBox.querySelector('.feed-footer span:last-child');
              if (footerSpan) {
                const frameCount = (col.frame_counts && col.frame_counts[sensor.id]) || 0;
                footerSpan.innerHTML = isRec ? `<span class="rec-pulse-chip">⏺ #${frameCount}</span>` : 'READY';
              }
            }
          });
        });
      }

      function updateSensorFeedSources() {
        state.edges.forEach(edge => {
          if (!edge.online) return;
          (edge.sensors || []).forEach(sensor => {
            const target = sensor.id || sensor.modality;
            const fKey = `${edge.device_id}:${target}`;
            const img = document.getElementById(`feed-img-${edge.device_id}-${target}`);
            const badge = document.getElementById(`badge-${edge.device_id}-${target}`);
            const tsSpan = document.getElementById(`ts-${edge.device_id}-${target}`);
            const btn1 = document.getElementById(`live-btn-${edge.device_id}-${target}`);
            const btn2 = document.getElementById(`live-btn-foot-${edge.device_id}-${target}`);

            const isPerSensorLive = Boolean(state.sensorLiveTimers && state.sensorLiveTimers[fKey]);
            const isLive = state.liveStreamingActive || isPerSensorLive;
            const remSec = state.liveStreamingActive
              ? state.streamTimeRemaining
              : ((state.sensorLiveRemaining && state.sensorLiveRemaining[fKey]) || 10);

            if (isLive) {
              const streamUrl = getStreamUrl(edge, target);
              if (img && img.src !== streamUrl) img.src = streamUrl;
              if (badge) {
                badge.className = 'live-stream-badge-overlay';
                badge.innerHTML = `<span class="live-pulse-dot"></span><span>LIVE (${remSec}s)</span>`;
              }
              if (tsSpan) tsSpan.textContent = `${sensor.fps || 15} fps (Live)`;
              if (btn1) {
                btn1.classList.add('active');
                btn1.textContent = `⏹ ${remSec}s`;
              }
              if (btn2) {
                btn2.classList.add('active');
                btn2.textContent = `⏹ ${remSec}s`;
              }
            } else {
              const ts = state.snapshotTimestamps[fKey] || Date.now();
              state.snapshotTimestamps[fKey] = ts;
              const snapshotUrl = getSnapshotUrl(edge, target, ts);
              if (img) img.src = snapshotUrl;
              const ageStr = formatFrameAge(ts);
              if (badge) {
                badge.className = 'snapshot-badge-overlay';
                badge.innerHTML = `<span>${ageStr}</span>`;
              }
              if (tsSpan) {
                tsSpan.textContent = ageStr;
                tsSpan.title = 'Captured: ' + new Date(ts).toLocaleTimeString();
              }
              if (btn1) {
                btn1.classList.remove('active');
                btn1.textContent = '🔄';
              }
              if (btn2) {
                btn2.classList.remove('active');
                btn2.textContent = '▶ Live';
              }
            }
          });
        });
      }

      function renderByDevice() {
        let html = '<div class="devices-grid">';
        state.edges.forEach(edge => {
          const isOnline = edge.online;
          const isGateway = Boolean(edge.is_gateway);
          const has4G = Boolean(isGateway || (edge.network && (edge.network.type === '5g' || edge.network.type === '4g' || (edge.network.interface && edge.network.interface.startsWith('usb')))));
          const pingVal = edge.ping_ms;
          const linkStatus = edge.link_status || (has4G ? 'gateway' : (isOnline ? 'good' : 'offline'));
          const pingLabel = isGateway ? '4G Gateway' : (has4G ? '4G Cellular' : (pingVal !== undefined ? `${pingVal}ms` : (isOnline ? 'Active' : 'Offline')));
          const pingIcon = has4G ? '📶' : (isOnline ? '⚡' : '⚪');

          const sensors = edge.sensors || [];
          const col = edge.collection || {};
          const isRec = col.is_recording;
          const freeGb = col.disk_free_gb !== undefined ? `${col.disk_free_gb} GB` : 'Ready';
          const isSingle = sensors.length <= 1;

          html += `
            <div class="device-card ${isSingle ? 'single-sensor' : 'multi-sensor'}" id="card-${edge.device_id}">
              <div class="device-card-header">
                <div class="device-card-title">
                  <div class="status-indicator ${isOnline ? '' : 'offline'}"></div>
                  <span class="device-name" title="${escapeHtml(edge.device_name || edge.device_id)}">${escapeHtml(edge.device_name || edge.device_id)}</span>
                  <span class="device-id-tag">${escapeHtml(edge.device_id)}</span>
                  <span class="ping-badge ${linkStatus}" title="Connection status: ${pingLabel}"><span class="ping-dot"></span>${pingIcon} ${pingLabel}</span>
                </div>
                <div class="device-telemetry">
                  ${isRec ? `<span class="rec-pulse-chip">⏺ ${col.duration_seconds || 0}s</span>` : ''}
                  <span class="storage-badge" title="SD Free: ${freeGb}">💾 ${freeGb}</span>
                </div>
              </div>
              
              <div class="${isSingle ? 'device-single-body' : 'sensors-grid'}">
                ${sensors.length > 0 ? sensors.map(s => renderSensorBox(edge, s, false)).join('') : `
                  <div class="empty-state" style="padding: 16px;">
                    <p style="font-size: 0.75rem;">${isOnline ? 'No sensors reported' : 'Edge device offline'}</p>
                  </div>
                `}
              </div>
            </div>
          `;
        });
        html += '</div>';
        el.feedsViewport.innerHTML = html;
      }

      function renderByModality() {
        const modalitiesMap = {};
        state.edges.forEach(edge => {
          if (!edge.online && (edge.last_seen_ago_s || 0) > 600) return;
          (edge.sensors || []).forEach(sensor => {
            const mod = (sensor.modality || 'other').toLowerCase();
            if (state.selectedModalityFilter !== 'all' && mod !== state.selectedModalityFilter) return;
            if (!modalitiesMap[mod]) modalitiesMap[mod] = [];
            modalitiesMap[mod].push({ edge, sensor });
          });
        });

        const modalities = Object.keys(modalitiesMap);
        if (modalities.length === 0) {
          el.feedsViewport.innerHTML = `
            <div class="empty-state">
              <p>No sensor feeds found for filter: <strong>${escapeHtml(state.selectedModalityFilter.toUpperCase())}</strong></p>
            </div>
          `;
          return;
        }

        let html = '';
        modalities.forEach(mod => {
          const items = modalitiesMap[mod];
          html += `
            <div class="modality-group-section">
              <div class="modality-section-header">
                <span class="feed-modality-badge modality-${mod}">${mod}</span>
                <span class="modality-section-title">${mod.toUpperCase()} Feeds (${items.length})</span>
              </div>
              <div class="sensors-grid">
                ${items.map(item => renderSensorBox(item.edge, item.sensor, true)).join('')}
              </div>
            </div>
          `;
        });
        el.feedsViewport.innerHTML = html;
      }

      function renderSensorBox(edge, sensor, showDeviceTag = false) {
        const target = sensor.id || sensor.modality;
        const fKey = `${edge.device_id}:${target}`;
        const isPerSensorLive = Boolean(state.sensorLiveTimers && state.sensorLiveTimers[fKey]);
        const isLive = state.liveStreamingActive || isPerSensorLive;
        const remSec = state.liveStreamingActive
          ? state.streamTimeRemaining
          : ((state.sensorLiveRemaining && state.sensorLiveRemaining[fKey]) || 10);

        const streamUrl = getStreamUrl(edge, target);
        const ts = state.snapshotTimestamps[fKey] || (state.snapshotTimestamps[fKey] = Date.now());
        const snapshotUrl = getSnapshotUrl(edge, target, ts);
        const currentSrc = isLive ? streamUrl : snapshotUrl;
        const frameAge = formatFrameAge(ts);
        const isFull = state.fullscreenSensorKey === `${edge.device_id}:${sensor.id}`;

        const mod = (sensor.modality || 'rgb').toLowerCase();
        const isRec = edge.collection && edge.collection.is_recording;
        const frameCount = (edge.collection && edge.collection.frame_counts && edge.collection.frame_counts[sensor.id]) || 0;
        const isGateway = Boolean(edge.is_gateway);
        const has4G = Boolean(isGateway || (edge.network && (edge.network.type === '5g' || edge.network.type === '4g' || (edge.network.interface && edge.network.interface.startsWith('usb')))));
        const linkStatus = edge.link_status || (has4G ? 'gateway' : (edge.online ? 'good' : 'offline'));
        const pingChip = has4G 
          ? `<span class="ping-badge gateway" style="font-size:0.6rem; padding:1px 5px;" title="${isGateway ? 'Master 4G Gateway' : '4G Dongle Cellular'}"><span class="ping-dot"></span>4G</span>`
          : (edge.ping_ms !== undefined 
              ? `<span class="ping-badge ${linkStatus}" style="font-size:0.6rem; padding:1px 5px;" title="Ping to Gateway: ${edge.ping_ms}ms"><span class="ping-dot"></span>${edge.ping_ms}ms</span>` 
              : '');

        return `
          <div class="feed-box ${isFull ? 'fullscreen-active' : ''}" id="sensor-${edge.device_id}-${sensor.id}">
            <div class="feed-box-header">
              <div style="display:flex; align-items:center; gap:6px; overflow:hidden;">
                <span class="feed-modality-badge modality-${mod}">${mod}</span>
                <span class="feed-name" title="${escapeHtml(sensor.name || sensor.id)}">${escapeHtml(sensor.name || sensor.id)}</span>
              </div>
              <div style="display:flex; align-items:center; gap:6px; flex-shrink:0;">
                ${pingChip}
                <span class="device-id-tag" title="${escapeHtml(edge.device_id)}">${escapeHtml(edge.device_name || edge.device_id)}</span>
                <button type="button" class="fullscreen-close-btn" onclick="window.toggleSensorFullscreen('${escapeHtml(edge.device_id)}', '${escapeHtml(sensor.id)}', '${escapeHtml(target)}')" title="Exit Full Screen (Esc)">✕ Close</button>
              </div>
            </div>

            <div class="feed-screen" onclick="window.toggleSensorFullscreen('${escapeHtml(edge.device_id)}', '${escapeHtml(sensor.id)}', '${escapeHtml(target)}', event)" style="cursor:pointer;" title="Click to toggle Full Screen">
              ${edge.online ? `
                <img src="${currentSrc}" alt="${sensor.name}" id="feed-img-${edge.device_id}-${target}" loading="lazy">
                <div class="feed-overlay-top-left">
                  <button type="button" class="sensor-refresh-btn-large" id="live-btn-${edge.device_id}-${target}" onclick="window.requestSensorSnapshot('${escapeHtml(edge.device_id)}', '${escapeHtml(target)}', event)" title="Refresh single frame">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
                      <path d="M3 3v5h5"/>
                      <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/>
                      <path d="M16 21h5v-5"/>
                    </svg>
                  </button>
                </div>
              ` : `
                <div class="display-off-overlay">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                    <line x1="1" y1="1" x2="23" y2="23"></line>
                  </svg>
                  <span>Edge Offline</span>
                </div>
              `}
            </div>

            <div class="feed-footer">
              <span></span>
              <span>${isRec ? `<span class="rec-pulse-chip">⏺ #${frameCount}</span>` : 'READY'}</span>
            </div>
          </div>
        `;
      }

      function formatFrameAge(ts) {
        if (!ts) return 'Just now';
        const diffSec = Math.max(0, Math.floor((Date.now() - ts) / 1000));
        if (diffSec < 2) return 'Just now';
        if (diffSec < 60) return `${diffSec}s ago`;
        const diffMin = Math.floor(diffSec / 60);
        if (diffMin < 60) return `${diffMin}m ago`;
        const diffHr = Math.floor(diffMin / 60);
        if (diffHr < 24) return `${diffHr}h+ ago`;
        const diffDays = Math.floor(diffHr / 24);
        return `${diffDays}d+ ago`;
      }

      function updateRelativeTimestamps() {
        if (state.liveStreamingActive) return;
        state.edges.forEach(edge => {
          (edge.sensors || []).forEach(sensor => {
            const target = sensor.id || sensor.modality;
            const fKey = `${edge.device_id}:${target}`;
            if (state.sensorLiveTimers && state.sensorLiveTimers[fKey]) return;
            const ts = state.snapshotTimestamps[fKey];
            if (!ts) return;
            const ageStr = formatFrameAge(ts);

            const badge = document.getElementById(`badge-${edge.device_id}-${target}`);
            if (badge && !state.liveStreamingActive) {
              badge.className = 'snapshot-badge-overlay';
              badge.innerHTML = `<span>${ageStr}</span>`;
            }

            const tsSpan = document.getElementById(`ts-${edge.device_id}-${target}`);
            if (tsSpan && !state.liveStreamingActive) {
              tsSpan.textContent = ageStr;
              tsSpan.title = 'Captured: ' + new Date(ts).toLocaleTimeString();
            }
          });
        });
      }

      function timeAgo(ts) {
        if (!ts) return 'Never';
        const diffSec = Math.floor(Date.now() / 1000 - ts);
        if (diffSec < 5) return 'Just now';
        if (diffSec < 60) return `${diffSec}s ago`;
        if (diffSec < 3600) return `${Math.floor(diffSec / 60)}m ago`;
        return `${Math.floor(diffSec / 3600)}h ago`;
      }

      window.focusDeviceFeed = function (deviceId) {
        el.modalBackdrop.classList.remove('open');
        if (state.viewMode !== 'device') switchViewMode('device');
        setTimeout(() => {
          const card = document.getElementById('card-' + deviceId);
          if (card) {
            card.scrollIntoView({ behavior: 'smooth', block: 'center' });
            card.style.outline = '2px solid var(--accent-cyan)';
            setTimeout(() => card.style.outline = '', 2000);
          }
        }, 150);
      };

      function renderFleetCards() {
        if (!el.fleetCardsContainer) return;

        const total = state.edges.length;
        const online = state.edges.filter(e => e.online).length;

        if (el.modalFleetBadge) el.modalFleetBadge.textContent = `${online}/${total}`;
        if (el.summaryTotalEdges) el.summaryTotalEdges.textContent = total;
        if (el.summaryOnlineEdges) el.summaryOnlineEdges.textContent = online;

        if (state.edges.length === 0) {
          el.fleetCardsContainer.innerHTML = `
            <div class="empty-state" style="padding: 24px;">
              <p>No edge devices registered in fleet yet.</p>
              <button class="submit-btn" style="margin-top: 10px;" onclick="window.switchModalTab('add')">+ Register First Device</button>
            </div>
          `;
          return;
        }

        el.fleetCardsContainer.innerHTML = state.edges.map(edge => {
          const hotspotSSID = edge.hotspot_ssid || (
            edge.device_id === 'edge-pi-zero-01' ? 'CaptureFleet2' :
            edge.device_id === 'edge-pi-zero-03' ? 'CaptureFleet1' :
            edge.device_id === 'edge-pi-zero-02' ? 'CaptureFleet3' :
            'CaptureFleet'
          );
          const isOnline = Boolean(edge.online);
          const net = edge.network || {};
          let netLabel = edge.host ? `${edge.host}:${edge.port}` : 'Default';
          let netIcon = '🌐';
          if (net.type === 'hotspot') {
            netIcon = '📱';
            netLabel = `Hotspot (${escapeHtml(net.ssid || 'Wi-Fi')}) • ${escapeHtml(net.ip || edge.host)}`;
          } else if (net.type === '5g') {
            netIcon = '📶';
            netLabel = `5G Cellular (${escapeHtml(net.interface || 'wwan0')}) • ${escapeHtml(net.ip || edge.host)}`;
          } else if (net.type === 'ethernet') {
            netIcon = '🔌';
            netLabel = `Ethernet (${escapeHtml(net.ip || edge.host)})`;
          }

          const sensors = edge.sensors || [];
          const sensorDesc = sensors.length > 0 
            ? sensors.map(s => `${escapeHtml(s.name || s.id)} (${s.resolution || '640x600'} @ ${s.fps || 15}fps)`).join(', ')
            : 'No sensors detected';

          const col = edge.collection || {};
          const storageDesc = col.disk_free_gb !== undefined 
            ? `${col.disk_free_gb} GB free of ${col.disk_total_gb || '--'} GB`
            : 'SD Card storage ready';

          const isGateway = Boolean(edge.is_gateway);
          const has4G = Boolean(isGateway || (edge.network && (edge.network.type === '5g' || edge.network.type === '4g' || (edge.network.interface && edge.network.interface.startsWith('usb')))));
          const pingVal = edge.ping_ms;
          const pingLabel = isGateway ? '0ms (Gateway)' : (pingVal !== undefined ? `${pingVal}ms ping` : 'Active');
          const lastSeenStr = edge.last_seen 
            ? timeAgo(edge.last_seen)
            : 'Never';
          const linkBadgeText = isOnline 
            ? (isGateway ? `📶 4G GATEWAY` : (has4G ? `📶 4G CELLULAR (${pingLabel})` : `🟢 ${edge.link_status ? edge.link_status.toUpperCase() : 'ONLINE'} (${pingLabel})`))
            : `⚪ OFFLINE (${lastSeenStr})`;

          return `
            <div class="fleet-device-card ${isOnline ? 'online' : 'offline'}">
              <div class="fleet-card-top">
                <div class="fleet-device-title-group">
                  <span class="fleet-device-name">
                    <span class="status-indicator ${isOnline ? '' : 'offline'}"></span>
                    ${escapeHtml(edge.device_name || edge.device_id)}
                  </span>
                  <span class="fleet-device-id">ID: <code>${escapeHtml(edge.device_id)}</code> &bull; Host: <code>${escapeHtml(edge.host)}:${edge.port}</code></span>
                </div>
                <div class="fleet-status-badge ${isOnline ? 'online' : 'offline'}">
                  ${linkBadgeText}
                </div>
              </div>

              <div class="fleet-details-grid">
                <div class="fleet-detail-item">
                  <span>${netIcon}</span>
                  <span><strong>Connection:</strong> ${netLabel}</span>
                </div>
                <div class="fleet-detail-item">
                  <span>📷</span>
                  <span><strong>Sensors:</strong> ${sensorDesc}</span>
                </div>
                <div class="fleet-detail-item">
                  <span>💾</span>
                  <span><strong>Storage:</strong> ${storageDesc}</span>
                </div>
                <div class="fleet-detail-item">
                  <span>⏱️</span>
                  <span><strong>Status:</strong> ${isOnline ? (col.is_recording ? `Recording (#${col.duration_seconds || 0}s)` : 'Standby / Ready') : 'Unreachable'}</span>
                </div>
              </div>

              <div class="fleet-hotspot-control">
                <div class="hotspot-status-label">
                  <span>📡 Wi-Fi Hotspot:</span>
                  <span class="hotspot-badge ${edge.hotspot_enabled !== false ? 'active' : 'disabled'}">
                    ${edge.hotspot_enabled !== false ? `🟢 ${hotspotSSID} (Active)` : `⚪ ${hotspotSSID} (Disabled)`}
                  </span>
                </div>
                <button 
                  class="btn-hotspot-toggle ${edge.hotspot_enabled !== false ? 'btn-hotspot-off' : 'btn-hotspot-on'}" 
                  onclick="window.toggleEdgeHotspot('${edge.device_id}', ${edge.hotspot_enabled === false})"
                  title="${edge.hotspot_enabled !== false ? `Turn off ${hotspotSSID} to save battery` : `Turn on ${hotspotSSID}`}">
                  ${edge.hotspot_enabled !== false ? `⚡ Turn OFF ${hotspotSSID}` : `📡 Turn ON ${hotspotSSID}`}
                </button>
              </div>

              <div class="fleet-card-actions">
                ${isOnline ? `
                  <button class="btn-action-view" onclick="window.focusDeviceFeed('${edge.device_id}')">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                      <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    View Feed
                  </button>
                ` : ''}
                <button class="btn-action-remove" onclick="window.removeEdgeDevice('${edge.device_id}')">
                  Remove Device
                </button>
              </div>
            </div>
          `;
        }).join('');
      }

      async function handleAddEdge(e) {
        e.preventDefault();
        const payload = {
          device_id: el.edgeIdInput.value.trim(),
          device_name: el.edgeNameInput.value.trim(),
          host: el.edgeHostInput.value.trim(),
          port: parseInt(el.edgePortInput.value.trim(), 10) || 5001
        };

        try {
          const res = await fetch(`${hubBaseUrl}/api/edges`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          if (res.ok) {
            el.addEdgeForm.reset();
            await pollData();
          }
        } catch (err) {
          alert('Failed to add edge device: ' + err);
        }
      }

      window.removeEdgeDevice = async function(deviceId) {
        if (!confirm(`Remove edge device "${deviceId}"?`)) return;
        try {
          await fetch(`${hubBaseUrl}/api/edges/${deviceId}`, { method: 'DELETE' });
          await pollData();
        } catch (err) {
          alert('Failed to remove edge: ' + err);
        }
      };

      window.toggleEdgeHotspot = async function(deviceId, targetState) {
        try {
          const btn = event?.currentTarget;
          if (btn) {
            btn.disabled = true;
            btn.textContent = 'Updating...';
          }
          const edge = state.edges.find(e => e.device_id === deviceId);
          const targetBase = (edge && edge.tunnel_url) ? edge.tunnel_url : hubBaseUrl;
          const url = (edge && edge.tunnel_url) ? ${targetBase}/api/hotspot : ${hubBaseUrl}/api/edges//hotspot;
          const res = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ enabled: targetState })
          });
          if (!res.ok) throw new Error('HTTP ' + res.status);
          const data = await res.json();
          if (edge) {
            edge.hotspot_enabled = data.hotspot_enabled !== false;
          }
          renderFleetCards();
        } catch (err) {
          alert('Failed to update hotspot for ' + deviceId + ': ' + err.message);
          renderFleetCards();
        }
      };

      function formatDuration(sec) {
        const s = Math.floor(sec);
        const hrs = Math.floor(s / 3600).toString().padStart(2, '0');
        const mins = Math.floor((s % 3600) / 60).toString().padStart(2, '0');
        const secs = (s % 60).toString().padStart(2, '0');
        return `${hrs}:${mins}:${secs}`;
      }

      function escapeHtml(str) {
        if (!str) return '';
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      document.addEventListener('DOMContentLoaded', init);
    })();
  </script>
</body>
</html>
